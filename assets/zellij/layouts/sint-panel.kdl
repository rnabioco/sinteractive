// The sinteractive session layout with the monitor panel open: shell, the
// panel (its own accent rule plus 12 rows), then the two-row status bar. Both
// sint panes keep the size they have in sint.kdl, so the layout swap only
// has to insert the panel — it never asks zellij to resize a retained
// fixed-size pane, which it will not do. See sint.kdl.
layout {
    pane borderless=true focus=true
    pane size=13 borderless=true {
        plugin location="file:__PLUGIN__" {
            view "monitor"
        }
    }
    pane size=2 borderless=true {
        plugin location="file:__PLUGIN__" {
            view "bar"
        }
    }
}
