// The sinteractive session layout with the monitor panel open: shell, the
// 12-row panel, then the one-row status bar. See sint.kdl.
layout {
    pane borderless=true focus=true
    pane size=12 borderless=true {
        plugin location="file:__PLUGIN__" {
            view "monitor"
        }
    }
    pane size=1 borderless=true {
        plugin location="file:__PLUGIN__" {
            view "bar"
        }
    }
}
