#!/bin/bash
# -*- coding: utf-8 -*-
#
# sinteractive — start an interactive shell on a Slurm compute node.
#
# Submits a batch job that launches a detached tmux session on the
# allocated node, then SSHes in and attaches to it. Because the shell
# lives in tmux, the session survives SSH drops and can be reattached
# later (see --attach / --list).
#
# Clean-room reimplementation, inspired by the original sinteractive by
# Pär Andersson (NSC, Sweden) and the later CU Boulder adaptation by
# Jonathon Anderson. Maintained by Jay Hesselberth.

# Treat unset variables as errors; the argument handling below guards every
# optional value explicitly, so this only fires on genuine bugs.
set -u

TMUX_BIN="${SINTERACTIVE_TMUX:-/usr/local/bin/tmux}"
JOB_ID=''
# Reported by --version; keep in sync with the release tag (vX.Y.Z).
VERSION='0.6.0'
# Basename for error messages ($0 is the full install path — noisy).
PROG="${0##*/}"

# ---------------------------------------------------------------------------
# Colour for the narration and for the reporting commands.
#
# Which stream is asked is not fixed. The launch and teardown narration goes
# to stderr, so the decision hangs on *stderr* being a terminal — the two
# differ in exactly the case that matters: `sinteractive --detach ... > file`
# still narrates to a terminal, and `sinteractive ... 2>log` must not write
# escapes into the log. The reporting commands (--list, --status, --help,
# --check-quota, --install-claude) print on stdout instead, and each calls
# `init_colors 1` before its first line so the same question is asked about
# the stream it actually writes to. Without that, `sinteractive --list | less`
# would carry escapes and a plain `sinteractive --list` would not.
#
# init_colors is therefore re-entrant: it clears the palette before deciding,
# so a second call for a different fd can turn colour back *off*.
#
# When colour is off every variable is the empty string rather than being
# guarded at each use, so one set of printf strings serves both cases and
# there is no second, less-tested code path.
#
# SINTERACTIVE_COLOR takes always/never/auto (default auto); NO_COLOR is
# honoured whatever its value, per no-color.org, and TERM=dumb opts out too.
# An explicit SINTERACTIVE_COLOR=always wins over both, for piping into
# something that renders escapes itself (`less -R`, CI logs that colourise).
# ---------------------------------------------------------------------------
C_RST='' C_BOLD='' C_DIM='' C_OK='' C_WARN='' C_ERR='' C_ID='' C_KEY='' C_HDR=''
function init_colors {
  local fd="${1:-2}"
  C_RST='' C_BOLD='' C_DIM='' C_OK='' C_WARN='' C_ERR='' C_ID='' C_KEY='' C_HDR=''
  local want="${SINTERACTIVE_COLOR:-auto}"
  case "$want" in
  never | no | 0) return 0 ;;
  always | yes | 1) ;;
  *)
    [[ -n "${NO_COLOR+x}" ]] && return 0
    [[ -t "$fd" ]] || return 0
    [[ "${TERM:-}" == dumb || -z "${TERM:-}" ]] && return 0
    ;;
  esac
  C_RST=$'\e[0m' C_BOLD=$'\e[1m' C_DIM=$'\e[2m'
  C_OK=$'\e[32m' C_WARN=$'\e[33m' C_ERR=$'\e[31m'
  # Teal for identifiers — job ids, node names — echoing the #2DBFB8 the
  # status bar uses for the same things, so the launch narration and the
  # session you land in agree about what is an identifier.
  C_ID=$'\e[1;36m' C_KEY=$'\e[1;33m'
  # Section headings. Same teal as C_ID today, but a separate name because it
  # is a separate job: it matches the headings in the Ctrl-b h help popup, so
  # `--help` and the popup read as one document.
  C_HDR=$'\e[1;36m'
}
init_colors

# Convert time shorthand (e.g. 8h, 30m, 2d, 1d12h, 1h30m) to HH:MM:SS
function parse_time {
  local input="$1"

  # Already in SLURM format (contains : or D-), pass through
  if [[ "$input" =~ [:] ]] || [[ "$input" =~ ^[0-9]+- ]]; then
    echo "$input"
    return
  fi

  # Pure integer = minutes (SLURM native)
  if [[ "$input" =~ ^[0-9]+$ ]]; then
    echo "$input"
    return
  fi

  local days=0 hours=0 minutes=0
  local remaining="$input"

  if [[ "$remaining" =~ ^([0-9]+)d ]]; then
    days="${BASH_REMATCH[1]}"
    remaining="${remaining#*d}"
  fi
  if [[ "$remaining" =~ ^([0-9]+)h ]]; then
    hours="${BASH_REMATCH[1]}"
    remaining="${remaining#*h}"
  fi
  if [[ "$remaining" =~ ^([0-9]+)m ]]; then
    minutes="${BASH_REMATCH[1]}"
    remaining="${remaining#*m}"
  fi

  if [[ -n "$remaining" ]]; then
    echo 1>&2 "${C_WARN}${C_BOLD}Warning:${C_RST}${C_WARN} unrecognized time format '$input', passing through to SLURM${C_RST}"
    echo "$input"
    return
  fi

  # Normalize carries so e.g. 90m -> 1h30m and 25h -> 1d1h, keeping each
  # field within range for SLURM's [D-]HH:MM:SS format.
  hours=$((hours + minutes / 60))
  minutes=$((minutes % 60))
  days=$((days + hours / 24))
  hours=$((hours % 24))

  if ((days > 0)); then
    printf '%d-%02d:%02d:00\n' "$days" "$hours" "$minutes"
  else
    printf '%02d:%02d:00\n' "$hours" "$minutes"
  fi
}

function usage {
  init_colors 1
  cat <<EOF
${C_HDR}Usage:${C_RST} sinteractive [OPTIONS] [-- SBATCH_ARGS...]
       sinteractive --attach [JOBID|NAME]

Start an interactive tmux session on a compute node via Slurm.
The session survives SSH drops; reconnect with ${C_KEY}--attach${C_RST}.

${C_HDR}Options:${C_RST}
  ${C_KEY}-n, --name NAME${C_RST}       Name the session for easy reattach
  ${C_KEY}--time TIME${C_RST}           Wall time limit (default: 1 day; e.g. 8h, 30m, 1d12h)
  ${C_KEY}-j, --threads N${C_RST}       Number of CPUs (default: 2)
  ${C_KEY}-m SIZE${C_RST}               Memory (default: 8G; e.g. 16G)
  ${C_KEY}-a, --attach [TARGET]${C_RST} Reattach: your only session, or one by JOBID or NAME
  ${C_KEY}--ensure NAME${C_RST}         Reuse the session named NAME, or launch it if absent
  ${C_KEY}--cancel TARGET${C_RST}       Cancel a session by JOBID or NAME
  ${C_KEY}--refresh [TARGET]${C_RST}    Re-check the time budget now (after scontrol)
  ${C_KEY}--check-quota${C_RST}         Re-check storage quota now and update every session
  ${C_KEY}--agent-context${C_RST}       Brief a coding agent on the session it is running in
  ${C_KEY}--install-claude${C_RST}      Install the Claude Code skills and hooks, and register them
  ${C_KEY}-l, --list${C_RST}            List your running sessions
  ${C_KEY}-h, --help${C_RST}            Show this help message
  ${C_KEY}-V, --version${C_RST}         Show version

${C_DIM}Unrecognized options pass through to sbatch (e.g. --partition, --gres).${C_RST}

${C_HDR}Examples:${C_RST}
  sinteractive                          ${C_DIM}# 1-day session, 2 CPUs, 8G memory${C_RST}
  sinteractive -n myproj --time=8h      ${C_DIM}# named 8-hour session${C_RST}
  sinteractive --attach                 ${C_DIM}# reconnect to your only session${C_RST}
  sinteractive --cancel myproj          ${C_DIM}# cancel a session by name${C_RST}

Inside the session, ${C_KEY}Ctrl-b h${C_RST} opens a help popup; ${C_KEY}Ctrl-b d${C_RST} detaches
(the job keeps running).

${C_WARN}A session is for orchestration, not compute:${C_RST} it is usually a small
allocation on the interactive partition, shared with the shell you are
typing in. Run work in its own allocation instead -- srun for a one-off,
salloc --no-shell plus srun --overlap for sustained work.

${C_DIM}Full documentation, including --detach/--status/--json for scripting,
--node, --mouse, and SINTERACTIVE_* environment variables:${C_RST}

  ${C_KEY}man sinteractive${C_RST}
EOF
  exit 0
}

function main {
  if [[ "${1:-}" == 'tmux' ]]; then
    shift
    start_tmux "$@"
    return
  elif [[ "${1:-}" == 'attach' ]]; then
    shift
    attach_tmux "$@"
    return
  elif [[ "${1:-}" == 'help-popup' ]]; then
    shift
    show_help_popup "$@"
    return
  elif [[ "${1:-}" == 'rename-session' ]]; then
    shift
    rename_session "$@"
    return
  fi

  # Parse custom flags before passing remaining args to sbatch
  local args=()
  local passthrough=()
  local do_attach=0
  local reattach_target=''
  local cancel_target=''
  local session_name=''
  local enable_mouse=0
  local detach_mode=0
  local json_out=0
  local do_list=0
  local do_status=0
  local do_refresh=0
  local do_agent_context=0
  local ensure_mode=0
  local do_install_claude=0
  local do_check_quota=0
  local status_target=''
  case "${SINTERACTIVE_MOUSE:-}" in
  on | 1 | true | yes) enable_mouse=1 ;;
  esac
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      usage
      ;;
    -V | --version)
      echo "sinteractive ${VERSION}"
      exit 0
      ;;
    --mouse)
      enable_mouse=1
      shift
      ;;
    --no-mouse)
      enable_mouse=0
      shift
      ;;
    --detach)
      detach_mode=1
      shift
      ;;
    --json)
      json_out=1
      shift
      ;;
    --status)
      do_status=1
      if [[ -n "${2:-}" && "$2" != -* ]]; then
        status_target="$2"
        shift 2
      else
        shift
      fi
      ;;
    --status=*)
      do_status=1
      status_target="${1#--status=}"
      shift
      ;;
    --refresh)
      # Same output as --status; additionally pokes the session's status loop
      # so the cached state file re-checks Slurm now rather than next poll.
      do_status=1
      do_refresh=1
      if [[ -n "${2:-}" && "$2" != -* ]]; then
        status_target="$2"
        shift 2
      else
        shift
      fi
      ;;
    --refresh=*)
      do_status=1
      do_refresh=1
      status_target="${1#--refresh=}"
      shift
      ;;
    --agent-context)
      do_agent_context=1
      shift
      ;;
    --install-claude)
      do_install_claude=1
      shift
      ;;
    --check-quota)
      do_check_quota=1
      shift
      ;;
    --ensure | --ensure=*)
      # Idempotent get-or-create: --name plus --detach, with the
      # already-running case turned from an error into the success path.
      if [[ "$1" == --ensure=* ]]; then
        session_name="${1#--ensure=}"
        shift
      else
        [[ $# -ge 2 && "$2" != -* ]] || {
          echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} --ensure requires a NAME argument.${C_RST}"
          exit 1
        }
        session_name="$2"
        shift 2
      fi
      if [[ -z "${session_name}" ]]; then
        echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} --ensure requires a NAME argument.${C_RST}"
        exit 1
      fi
      ensure_mode=1
      detach_mode=1
      ;;
    -l | --list)
      do_list=1
      shift
      ;;
    -a | --attach)
      # Target is optional: with none, reattach picks your only running
      # session (or lists them when there are several).
      do_attach=1
      if [[ -n "${2:-}" && "$2" != -* ]]; then
        reattach_target="$2"
        shift 2
      else
        shift
      fi
      ;;
    --attach=*)
      do_attach=1
      reattach_target="${1#--attach=}"
      if [[ -z "${reattach_target}" ]]; then
        echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} --attach= requires a JOBID or NAME argument.${C_RST}"
        echo 1>&2 "${C_DIM}Use a bare '--attach' to reattach to your only session.${C_RST}"
        exit 1
      fi
      shift
      ;;
    --cancel)
      if [[ -z "${2:-}" || "$2" == -* ]]; then
        echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} --cancel requires a JOBID or NAME argument.${C_RST}"
        echo 1>&2 "${C_DIM}Run 'sinteractive --list' to see available sessions.${C_RST}"
        exit 1
      fi
      cancel_target="$2"
      shift 2
      ;;
    --cancel=*)
      cancel_target="${1#--cancel=}"
      if [[ -z "${cancel_target}" ]]; then
        echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} --cancel requires a JOBID or NAME argument.${C_RST}"
        echo 1>&2 "${C_DIM}Run 'sinteractive --list' to see available sessions.${C_RST}"
        exit 1
      fi
      shift
      ;;
    -n | --name)
      [[ $# -ge 2 ]] || {
        echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} $1 requires a NAME argument.${C_RST}"
        exit 1
      }
      session_name="$2"
      shift 2
      ;;
    --name=*)
      session_name="${1#--name=}"
      shift
      ;;
    --node)
      [[ $# -ge 2 ]] || {
        echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} --node requires a NODE argument.${C_RST}"
        exit 1
      }
      args+=(--nodelist="$2")
      shift 2
      ;;
    --node=*)
      args+=(--nodelist="${1#--node=}")
      shift
      ;;
    --time)
      [[ $# -ge 2 ]] || {
        echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} --time requires a TIME argument.${C_RST}"
        exit 1
      }
      args+=(--time="$(parse_time "$2")")
      shift 2
      ;;
    --time=*)
      args+=(--time="$(parse_time "${1#--time=}")")
      shift
      ;;
    -t)
      [[ $# -ge 2 ]] || {
        echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} -t requires a TIME argument.${C_RST}"
        exit 1
      }
      args+=(-t "$(parse_time "$2")")
      shift 2
      ;;
    --partition)
      [[ $# -ge 2 ]] || {
        echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} --partition requires a PARTITION argument.${C_RST}"
        exit 1
      }
      args+=(--partition="$2")
      shift 2
      ;;
    --partition=*)
      args+=(--partition="${1#--partition=}")
      shift
      ;;
    -j | --threads)
      [[ $# -ge 2 ]] || {
        echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} $1 requires a CPU-count argument.${C_RST}"
        exit 1
      }
      args+=(--cpus-per-task="$2")
      shift 2
      ;;
    --threads=*)
      args+=(--cpus-per-task="${1#--threads=}")
      shift
      ;;
    -m)
      [[ $# -ge 2 ]] || {
        echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} -m requires a SIZE argument.${C_RST}"
        exit 1
      }
      args+=(--mem="$2")
      shift 2
      ;;
    # A single dash followed by two or more letters is almost always a
    # combined-flags typo (e.g. -la for ls -la muscle memory) or an attached
    # value (-nfoo); neither is supported here, and forwarding them to sbatch
    # produces a confusing error. Only intercept bundles starting with one of
    # our own short flags — anything else may be a valid sbatch attached-value
    # form (e.g. -wnode01) and still passes through.
    -[ahjlmnt][A-Za-z]*)
      local hint=''
      case "${1:1:1}" in
      a) hint="-a NAME (--attach)" ;;
      h) hint="-h (--help)" ;;
      j) hint="-j N (--threads)" ;;
      l) hint="-l (--list)" ;;
      m) hint="-m SIZE" ;;
      n) hint="-n NAME (--name)" ;;
      t) hint="-t TIME" ;;
      esac
      echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} unrecognized option '$1'.${C_RST}"
      echo 1>&2 "${C_DIM}Short options can't be combined or take attached values —${C_RST}"
      echo 1>&2 "${C_DIM}did you mean '${C_RST}${C_KEY}${hint}${C_RST}${C_DIM}'?${C_RST}"
      echo 1>&2 "${C_DIM}Run 'sinteractive --help' to see all options.${C_RST}"
      exit 1
      ;;
    *)
      args+=("$1")
      passthrough+=("$1")
      shift
      ;;
    esac
  done

  # Management commands; all exit. Run after flag parsing so they can be
  # combined with --json in any order, and before the nesting guard so they
  # work from inside a session (cancelling your own session ends it, like
  # walltime running out).
  if ((do_list)); then
    list_sessions "$json_out"
  fi
  if ((do_status)); then
    show_status "$status_target" "$json_out" "$do_refresh"
  fi
  if ((do_agent_context)); then
    agent_context
  fi
  if ((do_install_claude)); then
    install_claude
  fi
  if ((do_check_quota)); then
    if ((json_out)); then
      check_quota_cmd --json
    else
      check_quota_cmd
    fi
  fi
  # --ensure: if a session by this name is already there, report it and stop.
  # Deliberately quiet about a miss (unlike resolve_session_jobid) — not
  # finding one is the create path, not an error. A PENDING match counts as
  # existing and is reported with its real state rather than waited on, so the
  # caller decides whether to poll. The launch below re-checks for duplicates,
  # so two concurrent --ensure calls can still both create; that race is not
  # worth a lock.
  if ((ensure_mode)); then
    local ensure_existing
    ensure_existing=$(squeue --me --states RUNNING,PENDING --noheader \
      --Format=JobID:12,Comment:80 2>/dev/null |
      awk -v n="sinteractive:${session_name}" '$2 == n {print $1; exit}')
    if [[ -n "${ensure_existing}" ]]; then
      ((json_out)) || echo 1>&2 "${C_OK}✓${C_RST} ${C_DIM}Reusing existing session${C_RST} ${C_ID}${session_name}${C_RST}${C_DIM}.${C_RST}"
      show_status "${ensure_existing}" "$json_out" 0 false
    fi
  fi
  if [[ -n "${cancel_target}" ]]; then
    cancel_session "${cancel_target}"
  fi

  # Don't allow attaching (or an attaching launch) from inside an existing
  # session — both would nest tmux. A --detach launch never attaches, so it
  # is allowed from within a session.
  if [[ -n "${TMUX:-}" ]] && [[ "$TMUX" == *sinteractive* ]] &&
    { ((!detach_mode)) || ((do_attach)); }; then
    echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} Already inside an sinteractive session. Exit this session first.${C_RST}"
    exit 1
  fi

  if ((do_attach)); then
    reattach "${reattach_target}"
  fi

  if [[ -n "${session_name}" ]]; then
    if ! [[ "${session_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
      echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} --name must contain only letters, digits, '.', '_', '-'${C_RST}"
      exit 1
    fi
    # Best-effort duplicate-name guard: the Comment marker that records the
    # name is only set after submission (see below), so two near-simultaneous
    # launches with the same name can both pass here. Reattach-by-name
    # resolves the resulting ambiguity by erroring on multiple matches.
    local existing
    existing=$(squeue --me --states RUNNING,PENDING --noheader \
      --Format=JobID:12,Comment:80 2>/dev/null |
      awk -v n="sinteractive:${session_name}" '$2 == n {print $1}')
    if [[ -n "${existing}" ]]; then
      echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} A sinteractive session named '${session_name}' is already running:${C_RST}"
      echo 1>&2 "  ${C_DIM}JobID(s):${C_RST} ${C_ID}$(echo ${existing} | xargs)${C_RST}"
      echo 1>&2 "${C_DIM}Pick a different name, or reattach with: sinteractive --attach ${session_name}${C_RST}"
      exit 1
    fi
  fi

  set -- "${args[@]}"

  # If a session name was given and the user did not pass --job-name/-J,
  # set it so the name shows up natively in squeue output.
  if [[ -n "${session_name}" ]] && ! printf '%s\n' "$@" | grep -qE '^(--job-name|-J)'; then
    set -- --job-name="sint-${session_name}" "$@"
  fi

  # Defaults below can be personalized with SINTERACTIVE_* environment
  # variables (e.g. in ~/.bashrc); explicit flags always win.

  # Default to 1 day if no --time/-t specified
  if ! printf '%s\n' "$@" | grep -qE '^(--time|-t)'; then
    set -- --time="$(parse_time "${SINTERACTIVE_TIME:-24:00:00}")" "$@"
  fi

  # Default to interactive partition if no --partition/-p specified
  if ! printf '%s\n' "$@" | grep -qE '^(--partition|-p)'; then
    set -- --partition="${SINTERACTIVE_PARTITION:-interactive}" "$@"
  fi

  # Default the QOS from SINTERACTIVE_QOS if set and no --qos/-q specified.
  # Empty by default, so clusters that don't require an explicit QOS are
  # unaffected; set SINTERACTIVE_QOS where the scheduler mandates one.
  if [[ -n "${SINTERACTIVE_QOS:-}" ]] &&
     ! printf '%s\n' "$@" | grep -qE '^(--qos|-q)'; then
    set -- --qos="${SINTERACTIVE_QOS}" "$@"
  fi

  # Default to 2 CPUs if no --cpus-per-task/-c specified
  if ! printf '%s\n' "$@" | grep -qE '^(--cpus-per-task|-c)'; then
    set -- --cpus-per-task="${SINTERACTIVE_CPUS:-2}" "$@"
  fi

  # Default to 8G memory if no --mem specified
  if ! printf '%s\n' "$@" | grep -qE '^--mem'; then
    set -- --mem="${SINTERACTIVE_MEM:-8G}" "$@"
  fi

  # Trim --time to end before the next MAINT reservation, rather than letting
  # Slurm defer the job past the window. maint_* stay empty when there is no
  # conflict; when set they are both announced here and carried into the
  # session, which keeps the shortened allocation visible for its whole life
  # rather than only in the launch output that scrolls away.
  local maint_fit='' maint_name='' maint_start='' maint_orig=''
  local fit_out
  if ! fit_out=$(fit_maintenance_window "$@"); then
    exit 1
  fi
  if [[ -n "$fit_out" ]]; then
    read -r maint_fit maint_name maint_start maint_orig <<<"$fit_out"
    local fitted rewritten=()
    fitted=$(seconds_to_slurm_time "$maint_fit")
    mapfile -d '' -t rewritten < <(replace_time_in_args "$fitted" "$@")
    set -- "${rewritten[@]}"
    echo "${C_WARN}${C_BOLD}!${C_RST} ${C_WARN}Maintenance (${maint_name}) starts $(date -d "@$maint_start" '+%a %b %-d %H:%M').${C_RST}"
    echo "  ${C_DIM}Shortened the request from${C_RST} ${maint_orig} ${C_DIM}to${C_RST} ${C_BOLD}${fitted}${C_RST} ${C_DIM}so the session ends before it.${C_RST}"
    echo ''
  fi

  # Check interactive job limit before submitting
  local partition
  partition=$(get_partition_from_args "$@")

  if ! check_job_limit "$partition"; then
    exit 1
  fi

  # Heads-up when sessions are already running (a common accident after a
  # forgotten detach): point at --attach, then continue. Informational only —
  # the job-limit check above is what actually refuses.
  local running_sessions
  running_sessions=$(squeue --me --states RUNNING --noheader -o '%i|%k|%N' 2>/dev/null |
    awk -F'|' '$2 == "sinteractive" || index($2, "sinteractive:") == 1')
  if [[ -n "$running_sessions" ]]; then
    local n_running
    n_running=$(grep -c . <<<"$running_sessions")
    if ((n_running == 1)); then
      local rjob rcomment rnode rname=''
      IFS='|' read -r rjob rcomment rnode <<<"$running_sessions"
      [[ "$rcomment" =~ ^sinteractive:(.+)$ ]] && rname="${BASH_REMATCH[1]}"
      if [[ -n "$rname" ]]; then
        echo 1>&2 "${C_DIM}Note: you already have a running session named '${rname}' (job ${rjob} on ${rnode}).${C_RST}"
      else
        echo 1>&2 "${C_DIM}Note: you already have a running session (job ${rjob} on ${rnode}).${C_RST}"
      fi
      echo 1>&2 "${C_DIM}      Reattach with 'sinteractive --attach ${rname:-${rjob}}'; starting a new session...${C_RST}"
    else
      echo 1>&2 "${C_DIM}Note: you already have ${n_running} running sessions ('sinteractive --list' shows them).${C_RST}"
      echo 1>&2 "${C_DIM}      Starting a new session...${C_RST}"
    fi
  fi

  # Feature flags to forward to the batch-side tmux setup (start_tmux).
  local tmux_args=()
  ((enable_mouse)) && tmux_args+=(--mouse)
  [[ -n "${session_name}" ]] && tmux_args+=(--session-name="${session_name}")
  # Carried rather than recomputed in the session: the reservation is read
  # once, at submit time, and the session should say the same thing about its
  # own allocation for its whole life even if the reservation is later moved.
  [[ -n "$maint_start" ]] &&
    tmux_args+=(--maint="${maint_name}@${maint_start}")

  # Capture stdout and stderr separately: stdout carries the job id, stderr
  # carries errors (quoted below on failure) or warnings (passed through).
  local output sbatch_err sbatch_ec sbatch_errf
  sbatch_errf=$(mktemp)
  output=$(sbatch --output=/dev/null --error=/dev/null "$@" "${BASH_SOURCE[0]}" tmux "${tmux_args[@]}" 2>"$sbatch_errf")
  sbatch_ec=$?
  sbatch_err=$(<"$sbatch_errf")
  rm -f "$sbatch_errf"

  if ((sbatch_ec != 0)); then
    echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} job submission failed. sbatch said:${C_RST}"
    echo 1>&2 ''
    while IFS= read -r line; do
      echo 1>&2 "  $line"
    done <<<"${sbatch_err:-(no output)}"
    echo 1>&2 ''
    if ((${#passthrough[@]} > 0)); then
      echo 1>&2 "${C_DIM}Note: these options were not recognized by sinteractive and were${C_RST}"
      echo 1>&2 "${C_DIM}passed through to sbatch: ${passthrough[*]}${C_RST}"
      echo 1>&2 ''
    fi
    echo 1>&2 "${C_DIM}Run 'sinteractive --help' to see available options.${C_RST}"
    exit "$sbatch_ec"
  fi

  # Surface any sbatch warnings even on success.
  [[ -n "$sbatch_err" ]] && echo 1>&2 "$sbatch_err"

  JOB_ID=$(grep -Eo -e '\b[0-9]+$' <<<"${output}")
  if [[ -z "${JOB_ID}" ]]; then
    echo 1>&2 "${C_ERR}${C_BOLD}${PROG}:${C_RST}${C_ERR} sbatch succeeded but its output contained no job id:${C_RST}"
    echo 1>&2 "  ${output:-(no output)}"
    exit 1
  fi

  local job_comment="sinteractive"
  if [[ -n "${session_name}" ]]; then
    job_comment="sinteractive:${session_name}"
  fi
  scontrol update JobId="${JOB_ID}" Comment="${job_comment}"

  echo 1>&2 "${C_DIM}Submitted job${C_RST} ${C_ID}${JOB_ID}${C_RST}${C_DIM}, waiting for it to start.${C_RST}"

  # While the job is pending, show why (squeue's pend reason) and Slurm's
  # estimated start time. The scheduler is polled every 5 seconds; on a TTY a
  # spinner line redraws in place between polls (Ctrl-C cancels the job — see
  # cleanup), otherwise the old dot-per-poll trail is kept for logs.
  local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  local state='' reason='' start_str=''
  local wait_start now spin=0 last_poll=0 is_tty=0
  [[ -t 2 ]] && is_tty=1
  printf -v wait_start '%(%s)T' -1
  while true; do
    printf -v now '%(%s)T' -1
    if ((last_poll == 0 || now - last_poll >= 5)); then
      last_poll=$now
      IFS='|' read -r state reason start_str < <(squeue --jobs "${JOB_ID}" \
        --states PENDING,RUNNING --noheader -o '%T|%r|%S' 2>/dev/null)
      if [[ "${state}" == 'RUNNING' ]]; then
        ((is_tty)) && printf 1>&2 '\r\033[K'
        break
      elif [[ "${state}" != 'PENDING' ]]; then
        ((is_tty)) && printf 1>&2 '\r\033[K'
        echo 1>&2 "${C_ERR}${C_BOLD}${PROG}:${C_RST}${C_ERR} job is neither RUNNING nor PENDING. Aborting.${C_RST}"
        # Clean up here rather than via the EXIT trap: the job left the queue
        # on its own (failed or completed), so the trap's "Cancelled job"
        # message — meant for a user interrupt — would misreport what happened.
        scancel --quiet "${JOB_ID}"
        JOB_ID=''
        exit 1
      fi
      ((is_tty)) || echo 1>&2 -n '.'
    fi

    if ((is_tty)); then
      local why est=''
      case "$reason" in
      Resources) why='waiting for free resources' ;;
      Priority) why='waiting behind higher-priority jobs' ;;
      None | '') why='waiting for the job to start' ;;
      *) why="waiting (${reason})" ;;
      esac
      # Slurm's estimate can be absent (N/A) or already in the past just
      # before the job flips to RUNNING; show it only when it's ahead of now.
      if [[ -n "${start_str}" && "${start_str}" != 'N/A' ]]; then
        local start_epoch
        if start_epoch=$(date -d "${start_str}" +%s 2>/dev/null) &&
          ((start_epoch > now)); then
          if ((start_epoch - now < 86400)); then
            est=" — est. start $(date -d "@${start_epoch}" '+%H:%M')"
          else
            est=" — est. start $(date -d "@${start_epoch}" '+%a %H:%M')"
          fi
        fi
      fi
      printf 1>&2 '\r\033[K %s%s%s %s%s%s %s(%s elapsed)%s' \
        "$C_ID" "${frames[spin % 10]}" "$C_RST" \
        "$C_DIM" "${why}${est}" "$C_RST" \
        "$C_DIM" "$(format_short_duration $((now - wait_start)))" "$C_RST"
      spin=$((spin + 1))
      sleep 0.5
    else
      sleep 5
    fi
  done

  local batchhost
  batchhost=$(squeue --jobs "${JOB_ID}" --noheader --Format batchhost | xargs)

  echo 1>&2 ''
  echo 1>&2 "${C_DIM}Allocated ${C_RST}${C_ID}${batchhost}${C_RST}${C_DIM} — bringing up the session...${C_RST}"

  # A RUNNING job only means the allocation exists; the batch script still
  # has to bring up the tmux server. Poll for the session (a single SSH that
  # retries on the node) instead of guessing a fixed sleep, which races on a
  # slow or loaded node.
  local sock="sinteractive-${JOB_ID}"
  local connected=0
  if ssh -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new \
    "${batchhost}" \
    "for i in \$(seq 1 30); do ${TMUX_BIN} -L '${sock}' has-session -t '${sock}' 2>/dev/null && exit 0; sleep 1; done; exit 1"; then
    connected=1
  fi

  # The session is up (or we gave up waiting); from this point a detach or
  # disconnect should NOT cancel the job.
  trap - SIGINT SIGTERM EXIT

  if ((connected == 0)); then
    echo 1>&2 ''
    echo 1>&2 "${C_ERR}${C_BOLD}${PROG}:${C_RST}${C_ERR} tmux session did not come up on ${batchhost} within 30s.${C_RST}"
    echo 1>&2 "${C_DIM}Job ${JOB_ID} may still be starting. Reconnect with:${C_RST}"
    echo 1>&2 "  sinteractive --attach ${C_ID}${JOB_ID}${C_RST}"
    exit 1
  fi

  # Headless launch: report how to reach the session and return without
  # attaching (there may be no terminal to attach from). With --json the
  # status object is the whole output; show_status exits.
  if ((detach_mode)); then
    if ((json_out)); then
      show_status "${JOB_ID}" 1 0 "$( ((ensure_mode)) && echo true )"
    fi
    local attach_target="${session_name:-${JOB_ID}}"
    echo 1>&2 ''
    echo 1>&2 "${C_OK}${C_BOLD}✓${C_RST} ${C_BOLD}Session ${C_RST}${C_ID}${JOB_ID}${C_RST}${C_BOLD} is ready on ${C_RST}${C_ID}${batchhost}${C_RST}${C_BOLD}.${C_RST}"
    echo 1>&2 ''
    echo 1>&2 "  ${C_KEY}Attach:${C_RST}   sinteractive --attach ${attach_target}"
    echo 1>&2 "  ${C_KEY}Status:${C_RST}   sinteractive --status ${attach_target}"
    echo 1>&2 "  ${C_KEY}Cancel:${C_RST}   sinteractive --cancel ${attach_target}"
    return
  fi

  ssh -X -t "${batchhost}" "${BASH_SOURCE[0]}" attach "sinteractive-${JOB_ID}"

  # Give the batch script a moment to finish shutting down
  sleep 3

  # Check if the sinteractive job is still running after SSH exits
  local post_state
  post_state=$(squeue --jobs "${JOB_ID}" --states RUNNING --noheader --Format state 2>/dev/null | xargs)

  if [[ "${post_state}" == 'RUNNING' ]]; then
    echo 1>&2 ''
    echo 1>&2 "${C_WARN}${C_BOLD}⠿${C_RST} ${C_BOLD}Detached.${C_RST} ${C_DIM}Job${C_RST} ${C_ID}${JOB_ID}${C_RST} ${C_DIM}is still running on${C_RST} ${C_ID}${batchhost}${C_RST}${C_DIM}.${C_RST}"
    echo 1>&2 ''
    local attach_target="${JOB_ID}"
    if [[ -n "${session_name}" ]]; then
      attach_target="${session_name}"
    fi
    echo 1>&2 "  ${C_KEY}Reconnect:${C_RST}  sinteractive --attach ${attach_target}"
    echo 1>&2 "  ${C_KEY}Cancel:${C_RST}     scancel ${JOB_ID}"

    # Show other running sinteractive sessions. Pipe-delimited -o output
    # (not --Format columns) so long comments can't run into the next field
    # and shift the columns during parsing.
    local other_running
    other_running=$(squeue --me --states RUNNING --noheader -o '%i|%k|%N|%M|%l' 2>/dev/null |
      awk -F'|' -v self="${JOB_ID}" \
        '$1 != self && ($2 == "sinteractive" || index($2, "sinteractive:") == 1)')

    if [[ -n "$other_running" ]]; then
      echo 1>&2 ''
      echo 1>&2 "${C_DIM}Other running sinteractive sessions:${C_RST}"
      printf 1>&2 "  ${C_DIM}%-10s  %-14s  %-10s  %-10s${C_RST}\\n" 'JOBID' 'NODE' 'ELAPSED' 'TIMELIMIT'
      while IFS='|' read -r jobid comment node elapsed limit; do
        printf 1>&2 "  ${C_ID}%-10s${C_RST}  %-14s  %-10s  %-10s\\n" "$jobid" "$node" "$elapsed" "$limit"
      done <<<"$other_running"
    fi
  else
    echo 1>&2 "${C_DIM}Session ended. Job${C_RST} ${C_ID}${JOB_ID}${C_RST} ${C_DIM}is no longer running.${C_RST}"

    # Show any remaining sinteractive sessions. Pipe-delimited -o output
    # (not --Format columns) so long comments can't run into the next field
    # and shift the columns during parsing.
    local remaining
    remaining=$(squeue --me --states RUNNING --noheader -o '%i|%k|%N|%M|%l' 2>/dev/null |
      awk -F'|' '$2 == "sinteractive" || index($2, "sinteractive:") == 1')

    if [[ -n "$remaining" ]]; then
      echo 1>&2 ''
      echo 1>&2 "${C_WARN}You have other sinteractive sessions still running:${C_RST}"
      printf 1>&2 "  ${C_DIM}%-10s  %-14s  %-10s  %-10s${C_RST}\\n" 'JOBID' 'NODE' 'ELAPSED' 'TIMELIMIT'
      while IFS='|' read -r jobid comment node elapsed limit; do
        printf 1>&2 "  ${C_ID}%-10s${C_RST}  %-14s  %-10s  %-10s\\n" "$jobid" "$node" "$elapsed" "$limit"
      done <<<"$remaining"
      echo 1>&2 ''
      echo 1>&2 "${C_DIM}To free slots, cancel sessions you no longer need:${C_RST}"
      while IFS='|' read -r jobid _rest; do
        echo 1>&2 "  scancel $jobid"
      done <<<"$remaining"
    fi
  fi
}

# JSON-encode a string, escaping backslashes and double quotes; an empty
# string encodes as null.
function json_string_or_null {
  local s=$1
  if [[ -z "$s" ]]; then
    printf 'null'
    return
  fi
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  printf '"%s"' "$s"
}

# Convert a Slurm memory string (squeue %m, e.g. "8G", "96G", "4000M", "512")
# to whole megabytes. Echoes the integer and returns 0; returns 1 on anything
# unparseable ("N/A" for a job with no memory request), so the caller can emit
# null rather than a made-up number. A bare number is already megabytes, which
# is what --mem means to sbatch.
function mem_to_mb {
  local num unit
  [[ "$1" =~ ^([0-9]+)([KMGT]?)B?[nc]?$ ]] || return 1
  num="${BASH_REMATCH[1]}"
  unit="${BASH_REMATCH[2]}"
  case "$unit" in
  K) printf '%s' $((num / 1024)) ;;
  '' | M) printf '%s' "$num" ;;
  G) printf '%s' $((num * 1024)) ;;
  T) printf '%s' $((num * 1024 * 1024)) ;;
  esac
}

# Count GPUs in a squeue TRES-per-node field (%b): "gres:gpu:2", the typed
# form "gres:gpu:a100:2", or "N/A" when the job requested none. Always echoes
# an integer — a GPU-less job is 0, not null, because "no GPUs" is a fact here
# rather than a gap in what the scheduler told us.
function gpus_from_tres {
  [[ "$1" == *gpu* ]] || { printf '0'; return; }
  if [[ "$1" =~ gpu(:[A-Za-z0-9_.-]+)?:([0-9]+) ]]; then
    printf '%s' "${BASH_REMATCH[2]}"
  else
    printf '1'
  fi
}

# Query the current working directory of an sinteractive tmux session by
# asking tmux on the compute node. Returns empty string on failure.
function get_session_cwd {
  local node=$1 jobid=$2
  local sock="sinteractive-${jobid}"
  local session="sinteractive-${jobid}"
  local cwd
  cwd=$(ssh -o BatchMode=yes -o ConnectTimeout=3 -o StrictHostKeyChecking=accept-new \
    "$node" \
    "$TMUX_BIN -L '$sock' display-message -p -t '$session' '#{pane_current_path}'" \
    2>/dev/null)
  # Collapse $HOME prefix to ~ for readability
  if [[ -n "$cwd" && "$cwd" == "$HOME"* ]]; then
    cwd="~${cwd#$HOME}"
  fi
  printf '%s' "$cwd"
}

function list_sessions {
  local json=${1:-0}

  # Pipe-delimited -o output (not --Format columns) so empty fields can't
  # shift the ones after them during parsing.
  local lines
  lines=$(squeue --me --states RUNNING --noheader -o '%i|%k|%N|%P|%M|%l|%e|%C|%m|%b' 2>/dev/null |
    awk -F'|' '$2 == "sinteractive" || index($2, "sinteractive:") == 1')

  if [[ -z "$lines" ]]; then
    if ((json)); then
      echo '[]'
    else
      init_colors 1
      echo "${C_DIM}No running sinteractive sessions.${C_RST}"
      echo "Start one with ${C_KEY}sinteractive${C_RST}."
    fi
    exit 0
  fi

  # Query cwd for each session in parallel; results land in $tmpdir/<jobid>
  local tmpdir
  tmpdir=$(mktemp -d)
  trap 'rm -rf "$tmpdir"' EXIT
  local jobid comment node partition elapsed limit end_str cpus mem gres
  while IFS='|' read -r jobid comment node partition elapsed limit end_str cpus mem gres; do
    (get_session_cwd "$node" "$jobid" >"$tmpdir/$jobid") &
  done <<<"$lines"
  wait

  local name cwd
  if ((json)); then
    local out='[' first=1 now end_epoch remaining mem_mb
    printf -v now '%(%s)T' -1
    while IFS='|' read -r jobid comment node partition elapsed limit end_str cpus mem gres; do
      name=''
      if [[ "$comment" =~ ^sinteractive:(.+)$ ]]; then
        name="${BASH_REMATCH[1]}"
      fi
      cwd=$(<"$tmpdir/$jobid")
      ((first)) || out+=','
      first=0
      # squeue was filtered to RUNNING above; the field is here so this shape
      # matches --status --json, which callers otherwise have to special-case.
      mem_mb=$(mem_to_mb "$mem") || mem_mb=''
      out+="{\"job_id\":${jobid},\"name\":$(json_string_or_null "$name")"
      out+=",\"state\":\"RUNNING\""
      out+=",\"node\":\"${node}\",\"partition\":\"${partition}\""
      out+=",\"cpus\":${cpus},\"memory\":$(json_string_or_null "$mem")"
      out+=",\"memory_mb\":${mem_mb:-null},\"gpus\":$(gpus_from_tres "$gres")"
      out+=",\"elapsed\":\"${elapsed}\",\"time_limit\":\"${limit}\""
      # %e is N/A or Unknown for a job without a scheduled end; both fields
      # go null together rather than reporting a bogus budget.
      end_epoch=$(date -d "$end_str" +%s 2>/dev/null) || end_epoch=''
      remaining=''
      if [[ -n "$end_epoch" ]]; then
        remaining=$((end_epoch - now))
        ((remaining < 0)) && remaining=0
      fi
      out+=",\"end_epoch\":${end_epoch:-null},\"remaining_seconds\":${remaining:-null}"
      out+=",\"cwd\":$(json_string_or_null "$cwd")}"
    done <<<"$lines"
    echo "${out}]"
    exit 0
  fi

  # Colour goes outside every %-Ns, never inside it: an escape counted as
  # width would shift every column to its right.
  init_colors 1
  printf "${C_DIM}%-10s  %-20s  %-14s  %-12s  %-10s  %-10s  %s${C_RST}\n" \
    'JOBID' 'NAME' 'NODE' 'PARTITION' 'ELAPSED' 'TIMELIMIT' 'CWD'
  while IFS='|' read -r jobid comment node partition elapsed limit end_str cpus mem gres; do
    name='-'
    if [[ "$comment" =~ ^sinteractive:(.+)$ ]]; then
      name="${BASH_REMATCH[1]}"
    fi
    cwd=$(<"$tmpdir/$jobid")
    [[ -z "$cwd" ]] && cwd='-'
    printf "${C_ID}%-10s${C_RST}  ${C_BOLD}%-20s${C_RST}  ${C_ID}%-14s${C_RST}  %-12s  %-10s  %-10s  ${C_DIM}%s${C_RST}\n" \
      "$jobid" "$name" "$node" "$partition" "$elapsed" "$limit" "$cwd"
  done <<<"$lines"

  echo ''
  printf "${C_KEY}%-10s${C_RST} %s\n" 'Reattach:' 'sinteractive --attach JOBID|NAME'
  printf "${C_KEY}%-10s${C_RST} %s\n" 'Cancel:' 'sinteractive --cancel JOBID|NAME'
  exit 0
}

# Show status for one session (JOBID or NAME; defaults to the current session
# when run inside one). Human-readable by default; with json=1 emits a single
# JSON object for scripts and agents. Exits 0 if the job exists, 1 otherwise.
function show_status {
  local target=$1 json=$2 refresh=${3:-0} created=${4:-}
  # --ensure reports whether it launched the session or found one already
  # running; every other caller leaves the field off entirely rather than
  # emitting a meaningless "created":false.
  local extra=''
  [[ -n "$created" ]] && extra=",\"created\":${created}"

  if [[ -z "$target" ]]; then
    if [[ -n "${SINTERACTIVE_JOB_ID:-}" ]]; then
      target="${SINTERACTIVE_JOB_ID}"
    else
      echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} --status/--refresh requires a JOBID or NAME outside a session.${C_RST}"
      echo 1>&2 "${C_DIM}Run 'sinteractive --list' to see available sessions.${C_RST}"
      exit 1
    fi
  fi

  local jobid
  jobid=$(resolve_session_jobid "$target") || exit 1

  # --refresh: nudge the session's status loop to re-check its deadline and
  # rewrite the cached state file. The live query below already reports the
  # truth; this is what makes the cached copy agree within a tick, so "I just
  # extended this job with scontrol" is one command instead of a wait.
  # Fire-and-forget, like rename_session's poke.
  if ((refresh)); then
    touch "${HOME}/.cache/sinteractive/${jobid}.poke" 2>/dev/null || true
  fi

  local line
  line=$(squeue --jobs "$jobid" --noheader -o '%T|%e|%N|%P|%l|%M|%k|%C|%m|%b' 2>/dev/null)
  if [[ -z "$line" ]]; then
    if ((json)); then
      printf '{"job_id":%s,"state":"NOT_FOUND"}\n' "$jobid"
    else
      echo 1>&2 "${C_ERR}${C_BOLD}${PROG}:${C_RST}${C_ERR} job ${jobid} not found (finished or cancelled)${C_RST}"
    fi
    exit 1
  fi

  local state end_str node partition limit elapsed comment cpus mem gres
  IFS='|' read -r state end_str node partition limit elapsed comment cpus mem gres <<<"$line"

  # Allocation size, for sizing a separate allocation to run work in — not for
  # sizing work run inside the session itself. Deliberately absent from the
  # session environment for that reason; see start_tmux.
  local mem_mb gpus
  mem_mb=$(mem_to_mb "$mem") || mem_mb=''
  gpus=$(gpus_from_tres "$gres")

  local name=''
  if [[ "$comment" =~ ^sinteractive:(.+)$ ]]; then
    name="${BASH_REMATCH[1]}"
  fi

  local end_epoch='' remaining=''
  if [[ "$state" == 'RUNNING' ]]; then
    end_epoch=$(date -d "$end_str" +%s 2>/dev/null) || end_epoch=''
    if [[ -n "$end_epoch" ]]; then
      remaining=$((end_epoch - $(date +%s)))
      ((remaining < 0)) && remaining=0
    fi
  fi

  if ((json)); then
    # Same field order as --list --json, which additionally carries "cwd" —
    # that costs an SSH round-trip per session, and this path is on the hot
    # path for agents polling a single session, so it stays out.
    printf '{"job_id":%s,"name":%s,"state":"%s","node":%s,"partition":"%s","cpus":%s,"memory":%s,"memory_mb":%s,"gpus":%s,"time_limit":"%s","elapsed":"%s","end_epoch":%s,"remaining_seconds":%s%s}\n' \
      "$jobid" "$(json_string_or_null "$name")" "$state" \
      "$(json_string_or_null "$node")" "$partition" \
      "${cpus:-null}" "$(json_string_or_null "$mem")" "${mem_mb:-null}" \
      "$gpus" "$limit" "$elapsed" \
      "${end_epoch:-null}" "${remaining:-null}" "$extra"
  else
    init_colors 1
    # Green only for RUNNING; PENDING and every terminal state are things you
    # would want to notice, so they share the warning colour.
    local state_c="${C_WARN}"
    [[ "$state" == 'RUNNING' ]] && state_c="${C_OK}"
    local title="${C_BOLD}Session${C_RST} ${C_ID}${jobid}${C_RST}"
    [[ -n "$name" ]] && title+=" ${C_BOLD}(${name})${C_RST}"
    echo "${title}: ${state_c}${state}${C_RST}${node:+ ${C_DIM}on${C_RST} ${C_ID}${node}${C_RST}}"
    printf "  ${C_KEY}%-11s${C_RST} %s\n" 'Partition:' "$partition"
    local res="${cpus} CPUs, ${mem}"
    ((gpus > 0)) && res+=", ${gpus} GPU"
    ((gpus > 1)) && res+='s'
    printf "  ${C_KEY}%-11s${C_RST} %s\n" 'Resources:' "$res"
    printf "  ${C_KEY}%-11s${C_RST} %s ${C_DIM}(limit %s)${C_RST}\n" 'Elapsed:' "$elapsed" "$limit"
    if [[ -n "$remaining" ]]; then
      # The one number worth reading at a glance, so it is coloured by how
      # much of it is left rather than left the same shade all session.
      local rem_c="${C_OK}"
      ((remaining < 3600)) && rem_c="${C_WARN}"
      ((remaining < 900)) && rem_c="${C_ERR}"
      printf "  ${C_KEY}%-11s${C_RST} ${rem_c}%s${C_RST}\n" \
        'Remaining:' "$(format_short_duration "$remaining")"
    fi
  fi
  exit 0
}

# Briefing for a coding agent running inside a session (Claude Code and
# friends), printed on stdout; exits 1 with a one-line note when run outside
# one. The wording lives here rather than in the SessionStart hook so it is
# versioned with the tool, and so a human can run the command to see exactly
# what the agent was told.
#
# The load-bearing message is that the session is NOT a compute target: it is
# usually a small allocation on the interactive partition, and work run in it
# competes with the shell the user is typing in. That is also why the resource
# numbers below are reported but never exported as environment variables — a
# SINTERACTIVE_CPUS in the environment is an invitation to run `make -j` here.
function agent_context {
  if [[ -z "${SINTERACTIVE_JOB_ID:-}" ]]; then
    echo 1>&2 "${C_ERR}${C_BOLD}${PROG}:${C_RST}${C_ERR} not inside an sinteractive session (SINTERACTIVE_JOB_ID unset).${C_RST}"
    exit 1
  fi
  local jobid="${SINTERACTIVE_JOB_ID}"

  local line
  line=$(squeue --jobs "$jobid" --noheader -o '%T|%e|%N|%P|%C|%m|%b|%k' 2>/dev/null)
  if [[ -z "$line" ]]; then
    echo 1>&2 "${C_ERR}${C_BOLD}${PROG}:${C_RST}${C_ERR} job ${jobid} not found (finished or cancelled)${C_RST}"
    exit 1
  fi

  local state end_str node partition cpus mem gres comment
  IFS='|' read -r state end_str node partition cpus mem gres comment <<<"$line"

  local name=''
  if [[ "$comment" =~ ^sinteractive:(.+)$ ]]; then
    name="${BASH_REMATCH[1]}"
  fi

  local res="${cpus} CPUs, ${mem}"
  local gpus
  gpus=$(gpus_from_tres "$gres")
  ((gpus > 0)) && res+=", ${gpus} GPU"
  ((gpus > 1)) && res+='s'

  local budget='walltime unknown'
  local end_epoch remaining
  if end_epoch=$(date -d "$end_str" +%s 2>/dev/null); then
    remaining=$((end_epoch - $(date +%s)))
    ((remaining < 0)) && remaining=0
    budget="walltime $(format_short_duration "$remaining") remaining"
  fi

  local ident="job ${jobid}"
  [[ -n "$name" ]] && ident+=" (${name})"

  # Only stated when it is true and already known. The briefing runs at every
  # session start, so it reads the cache rather than probing nine daemons —
  # and says nothing at all when there is no cache or the user is under.
  local quota_line='' q_over q_used q_hard q_over_kb q_pct
  if read -r q_over q_used q_hard q_over_kb q_pct _ < <(quota_cached) &&
    [[ "${q_over:-0}" == 1 ]]; then
    quota_line=$(printf '\nOVER STORAGE QUOTA: %s of %s used (%s%%), over by %s.\n' \
      "$(quota_kb_to_size "$q_used")" "$(quota_kb_to_size "$q_hard")" \
      "$q_pct" "$(quota_kb_to_size "$q_over_kb")")
  fi

  cat <<CONTEXT
You are inside an sinteractive tmux session on a compute node.
  ${ident} on ${node}, partition ${partition} — ${res}
  ${budget} (the session self-terminates ~10s before the limit)

This session is an orchestration shell, NOT a compute target. Editing, git and
scheduler queries belong here; anything heavier gets its own allocation, so it
neither competes with the shell the user is typing in nor is squeezed into
this session's small slice of CPU and memory.

  one-off     srun -p PART -c N --mem SIZE -t TIME -J NAME --comment=NAME -- CMD
  sustained   salloc --no-shell -p PART -c N --mem SIZE -t TIME -J NAME --comment=NAME
              srun --overlap --jobid=ID -- CMD                    # repeat as needed
              scancel ID                                          # when done

Both stream output and propagate the command's exit code. salloc announces
itself with "salloc: Granted job allocation ID" on stderr, not stdout, so
capture it through 2>&1.

Name every job in both fields — -J NAME and --comment=NAME, the same short
descriptive value ('bwa-align', not 'bash') — so a shared queue says what is
running and why; \`squeue --me -o "%.10i %.20j %.20P %.10M %k"\` shows the name
in %j and the comment in %k. Both belong to the allocation, so naming the
salloc covers its srun --overlap steps.

Pick PART with \`sinfo\`; the interactive partition has few nodes, caps
walltime and carries everyone's shells, so it is not the right target for
work — send it to a compute partition instead. SLURM_* is stripped from this
session, so srun and salloc create their own allocations rather than steps of
this job — and work in them is bounded by their own -t, not by the budget above.

Re-check this session with \`sinteractive --status --json\` before long work;
the number above was read when this briefing was generated, and a walltime can
be changed underneath you.
${quota_line}
Storage quota is shown on a line below the status bar while it is exceeded.
Check it with \`sinteractive --check-quota\`, and run that again after
deleting anything on the user's behalf — it refreshes every open session, so
the warning clears immediately rather than up to ten minutes later.
CONTEXT
  exit 0
}

# Whether the Claude Code integration is live for this user: the hooks are
# installed AND registered in a settings file. Installed-but-unregistered is
# the interesting failure — the files sit there doing nothing — so presence
# alone is not enough.
#
# Registration is checked by grepping for the hook's filename rather than
# parsing JSON. settings.json is the user's file, the hooks may be registered
# from either the plain or .local variant, and a bash JSON parser here would
# be likelier to be wrong than the string test. A false "active" (the name
# appears in a comment-like string) only costs a missing hint.
function claude_integration_active {
  local dir="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
  [[ -e "${dir}/hooks/sinteractive-session-context.sh" ]] || return 1
  grep -qs 'sinteractive-session-context' \
    "${dir}/settings.json" "${dir}/settings.local.json" || return 1
  return 0
}

# ---------------------------------------------------------------------------
# Storage quota.
#
# Two halves, both readable from a compute node, which is what lets a session
# answer this itself:
#
#   - the hard limit, from a shared pipe-delimited file (user|size|email);
#   - current usage, from the quota daemons. Each answers "QUOTA <uid>" with
#     "OK <kilobytes>" for the storage targets it owns, and a user's total is
#     the sum across all of them.
#
# This mirrors what Bodhi's own quota_check does. That script lives only on
# the head node, so the obvious implementation is `ssh head quota_check` — but
# the daemons listen to the compute nodes directly and the quota file is on
# shared storage, so a session can ask for itself. No ssh, no head node, and
# nothing to install: the whole probe is bash and /dev/tcp, and costs about a
# second.
#
# Every default here is overridable, and every failure is silent. A cluster
# without these daemons or that file simply never shows a quota notice, which
# is the right outcome for one that does its quotas differently.
# ---------------------------------------------------------------------------
QUOTA_FILE_DEFAULT='/cluster/scripts/quota_current.txt'
QUOTA_HOSTS_DEFAULT='172.20.8.110 172.20.8.111 172.20.8.112 172.20.8.113 172.20.8.114 172.20.8.115 172.20.8.116 172.20.8.117 172.20.8.118'
QUOTA_PORT_DEFAULT=9878

# Parse a size like "30.0TiB", "4T" or "512M" into kilobytes. Mirrors
# quota_check's parse_size_to_kb, IEC suffixes included, because the numbers
# have to agree with what the cluster's own tool reports or nobody will trust
# either. Bash has no floats, so awk does the multiply.
function quota_size_to_kb {
  awk -v s="${1:-}" 'BEGIN {
    if (match(s, /^[0-9.]+/) == 0) { exit 1 }
    n = substr(s, RSTART, RLENGTH)
    u = toupper(substr(s, RSTART + RLENGTH))
    sub(/^[ \t]+/, "", u); sub(/IB$/, "", u); sub(/B$/, "", u)
    m[""] = 1; m["K"] = 1; m["M"] = 1024
    m["G"] = 1024 ^ 2; m["T"] = 1024 ^ 3; m["P"] = 1024 ^ 4
    if (!(u in m)) { exit 1 }
    printf "%d", n * m[u]
  }' || return 1
}

# Kilobytes back to a short human string, the same ladder quota_check uses.
function quota_kb_to_size {
  awk -v k="${1:-0}" 'BEGIN {
    split("K M G T P", u, " ")
    i = 1
    while (k >= 1024 && i < 5) { k /= 1024; i++ }
    if (k == int(k)) { printf "%d%s", k, u[i] } else { printf "%.1f%s", k, u[i] }
  }'
}

# This user's hard limit, in KB. Fails when the file is absent or has no row
# for them — an unlimited or unlisted user gets no notice rather than a wrong
# one.
function quota_hard_kb {
  local file="${SINTERACTIVE_QUOTA_FILE:-$QUOTA_FILE_DEFAULT}"
  [[ -r "$file" ]] || return 1
  local size
  size=$(awk -F'|' -v u="${USER:-$(id -un)}" \
    '$1 == u { gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2; exit }' "$file") || return 1
  [[ -n "$size" ]] || return 1
  quota_size_to_kb "$size"
}

# Current usage in KB, summed over the daemons. One short-lived TCP connection
# each, done in series: nine sub-100ms round-trips inside a poll that runs
# every ten minutes is not worth backgrounding, and series keeps the failure
# handling legible.
#
# A daemon that is down is skipped rather than fatal, but if none answers we
# fail — a partial sum would understate usage and could silently clear a real
# over-quota warning, which is worse than showing nothing.
function quota_used_kb {
  local port="${SINTERACTIVE_QUOTA_PORT:-$QUOTA_PORT_DEFAULT}"
  local uid total=0 answered=0 host line kb
  uid=$(id -u)
  for host in ${SINTERACTIVE_QUOTA_HOSTS:-$QUOTA_HOSTS_DEFAULT}; do
    exec {qfd}<>"/dev/tcp/${host}/${port}" 2>/dev/null || continue
    printf 'QUOTA %s\n' "$uid" >&"$qfd" || true
    line=''
    read -r -t "${SINTERACTIVE_QUOTA_TIMEOUT:-5}" line <&"$qfd" || true
    exec {qfd}<&- 2>/dev/null
    exec {qfd}>&- 2>/dev/null
    case "$line" in
    'OK '*)
      kb=${line#OK }
      kb=${kb%%[!0-9]*}
      [[ -n "$kb" ]] || continue
      total=$((total + kb))
      answered=$((answered + 1))
      ;;
    esac
  done
  ((answered)) || return 1
  printf '%s' "$total"
}

# Probe both halves and rewrite the cache. Echoes "used_kb hard_kb" on
# success.
#
# The cache is per user rather than per job: quota is a property of the
# account, a user often has several sessions open, and there is no sense in
# each of them interrogating nine daemons on its own schedule. Written through
# a temp file in the same directory so a session reading it never sees a
# half-written one, and named without a job id so status_dot_loop's teardown
# (which removes files by job id) leaves it alone.
function quota_probe {
  # Hard limit first, deliberately. It is a local file read that fails
  # instantly on a cluster without one, and it gates the network half —
  # bash's /dev/tcp has no connect timeout, so nine attempts at unroutable
  # addresses could stall the status loop for minutes. Somewhere without the
  # quota file never opens a socket at all.
  local used hard
  hard=$(quota_hard_kb) || return 1
  ((hard > 0)) || return 1
  used=$(quota_used_kb) || return 1

  local dir="${HOME}/.cache/sinteractive"
  mkdir -p "$dir" 2>/dev/null || return 1
  local file="${dir}/quota.json" tmp
  tmp=$(mktemp "${file}.XXXXXX" 2>/dev/null) || return 1

  local over=0 over_kb=0
  if ((used > hard)); then
    over=1
    over_kb=$((used - hard))
  fi
  local now
  printf -v now '%(%s)T' -1
  local pct
  pct=$(awk -v u="$used" -v h="$hard" 'BEGIN { printf "%.1f", (u * 100) / h }')

  printf '{"user":"%s","used_kb":%s,"hard_kb":%s,"over_kb":%s,"pct":%s,"over":%s,"checked_epoch":%s}\n' \
    "${USER:-$(id -un)}" "$used" "$hard" "$over_kb" "$pct" \
    "$((over ? 1 : 0))" "$now" >"$tmp" 2>/dev/null || {
    rm -f "$tmp"
    return 1
  }
  chmod 0644 "$tmp" 2>/dev/null
  mv -f "$tmp" "$file" 2>/dev/null || {
    rm -f "$tmp"
    return 1
  }
  printf '%s %s' "$used" "$hard"
}

# Read the cached probe, echoing "over used_kb hard_kb over_kb pct age_secs".
# Fails when there is no cache — the caller then shows nothing.
function quota_cached {
  local file="${HOME}/.cache/sinteractive/quota.json"
  [[ -r "$file" ]] || return 1
  local now
  printf -v now '%(%s)T' -1
  awk -v now="$now" '{
    for (i = 1; i <= 6; i++) v[i] = 0
    if (match($0, /"used_kb":[0-9]+/))  v[2] = substr($0, RSTART + 10, RLENGTH - 10)
    if (match($0, /"hard_kb":[0-9]+/))  v[3] = substr($0, RSTART + 10, RLENGTH - 10)
    if (match($0, /"over_kb":[0-9]+/))  v[4] = substr($0, RSTART + 10, RLENGTH - 10)
    if (match($0, /"pct":[0-9.]+/))     v[5] = substr($0, RSTART + 6, RLENGTH - 6)
    if (match($0, /"over":[01]/))       v[1] = substr($0, RSTART + 7, RLENGTH - 7)
    if (match($0, /"checked_epoch":[0-9]+/)) v[6] = now - substr($0, RSTART + 16, RLENGTH - 16)
    print v[1], v[2], v[3], v[4], v[5], v[6]
    exit
  }' "$file"
}

# Poke every live session so a fresh probe reaches their notice lines on the
# next tick rather than at the end of the ten-minute poll. This is what makes
# `--check-quota` feel immediate after deleting something.
function poke_all_sessions {
  local dir="${HOME}/.cache/sinteractive" f jobid
  [[ -d "$dir" ]] || return 0
  for f in "$dir"/*.json; do
    [[ -e "$f" ]] || continue
    jobid=$(basename "$f" .json)
    [[ "$jobid" == quota ]] && continue
    touch "${dir}/${jobid}.poke" 2>/dev/null || true
  done
}

# --check-quota: probe now, rewrite the cache, tell every session to re-read
# it, and report. Exits 0 whether or not the user is over — being over quota
# is a fact to report, not an error in the check.
function check_quota_cmd {
  local json=0
  [[ "${1:-}" == --json ]] && json=1

  if ! quota_probe >/dev/null; then
    if ((json)); then
      echo '{"error":"quota unavailable"}'
    else
      echo 1>&2 "${C_ERR}${C_BOLD}${PROG}:${C_RST}${C_ERR} could not read quota.${C_RST}"
      echo 1>&2 ''
      echo 1>&2 "${C_DIM}Needs the quota file (${SINTERACTIVE_QUOTA_FILE:-$QUOTA_FILE_DEFAULT})${C_RST}"
      echo 1>&2 "${C_DIM}and at least one reachable quota daemon. Override with${C_RST}"
      echo 1>&2 "${C_DIM}SINTERACTIVE_QUOTA_FILE, SINTERACTIVE_QUOTA_HOSTS and${C_RST}"
      echo 1>&2 "${C_DIM}SINTERACTIVE_QUOTA_PORT.${C_RST}"
    fi
    exit 1
  fi
  poke_all_sessions

  if ((json)); then
    cat "${HOME}/.cache/sinteractive/quota.json"
    exit 0
  fi

  local over used hard over_kb pct
  read -r over used hard over_kb pct _ < <(quota_cached)
  init_colors 1
  # Wording matched to the status-bar notice and quoted verbatim in
  # skills/bodhi-storage/SKILL.md — colour is the only thing added here.
  if ((over)); then
    printf "${C_ERR}${C_BOLD}OVER QUOTA:${C_RST}${C_ERR} %s of %s used (%s%%), over by %s${C_RST}\n" \
      "$(quota_kb_to_size "$used")" "$(quota_kb_to_size "$hard")" \
      "$pct" "$(quota_kb_to_size "$over_kb")"
  else
    printf "${C_OK}${C_BOLD}Quota OK:${C_RST} %s of %s used (%s%%)\n" \
      "$(quota_kb_to_size "$used")" "$(quota_kb_to_size "$hard")" "$pct"
  fi
  exit 0
}

# Anything the session has to say about itself goes below the status bar, on
# tmux status lines of its own — never squeezed into the session line or onto
# the rule above it. There are two, each present only while it has something
# to say, and each costing a row of pane height only while it is there:
#
#   1. warnings — quota (red, flush left) and a maintenance-trimmed end time
#      (yellow, flush right). Both hold for the whole session, so they share
#      their line rather than taking turns, one at each end of it.
#   2. the Claude Code hint (yellow) — purely an offer, so it sits furthest
#      from the session line and is the first thing to go.
#
# All of it used to live on the pane border, one line carrying three
# unrelated things and, for the hint, scrolling them past. Full-width lines
# of their own need no marquee: the hint fits a normal terminal whole, which
# also drops the 0.3s redraw the scroll cost every session that showed it.
# The overage, not the usage: it is the number you act on, and "over by X"
# says on its own that you are over — so the word OVER, the used figure and
# the percentage all come out and the line still says the same thing.
function quota_notice_string {
  local over="$1" hard="$2" over_kb="$3"
  ((over)) || return 1
  printf '#[fg=red,bold] ⚠ QUOTA over by %s (%s limit) #[default]' \
    "$(quota_kb_to_size "$over_kb")" "$(quota_kb_to_size "$hard")"
}

# No SHORT SESSION label: sitting on the warnings line, in yellow, opposite
# the quota warning, an end time that is not the one you asked for is already
# reading as a warning. The reservation name is what you would look up.
function maint_notice_string {
  local name="$1" start_epoch="$2"
  [[ -n "$start_epoch" ]] || return 1
  printf '#[fg=yellow,bold] ends %s · %s #[default]' \
    "$(date -d "@$start_epoch" '+%a %H:%M' 2>/dev/null)" "$name"
}

# The hint is one line whether or not it fits: at a narrow width tmux cuts
# the tail, and the command — the only part that has to be read — is early
# enough to survive that.
function hint_notice_string {
  local wanted="$1"
  ((wanted)) || return 1
  printf '#[fg=yellow] Claude Code: run #[bold]sinteractive --install-claude#[nobold] to enable the skills and hooks #[default]'
}

# Quota flush left, maintenance flush right — the same two ends the session
# line above already uses, so the notices sit under something rather than
# starting in the middle of the line. Each half keeps its side whether or not
# the other is there, so a notice does not move when its neighbour appears.
#
# tmux resolves each #[align=...] against the whole line, which is how the
# stock status-format[0] gets status-left and status-right onto one row; the
# separator the two used to share is what the gap between them replaces. Every
# part already carries its own padding, so neither touches the screen edge.
function compose_notice {
  local quota_part="$1" maint_part="$2"
  [[ -n "$quota_part" ]] && printf '%s' "#[align=left]${quota_part}"
  [[ -n "$maint_part" ]] && printf '%s' "#[align=right]${maint_part}"
  return 0
}

# Put the given lines below the status bar, in order, and size the status bar
# to hold them. Callers pass only the lines that have something on them, so
# the hint moves up to line 1 when there is no warning and there is never a
# blank row between the session line and a notice.
#
# Formats are set before the status bar grows, so tmux never draws a frame of
# its own default line 1 (the window list) on the way in. Shrinking leaves
# the stale formats in place: they are not rendered, and clearing them would
# cost a round trip each.
#
# status-format is set globally and status per session, which looks
# inconsistent and is not. Setting one element of an option array at session
# scope replaces the whole array for that session rather than overlaying the
# global one, so a session-scoped status-format[1] leaves status-format[0]
# empty — and the session line, the thing these are meant to sit under,
# silently disappears. Setting the extra indices globally leaves the default
# index 0 alone. (Every job has its own tmux server, so global here is still
# one session's worth of scope.)
function apply_notice_lines {
  local sock="$1" session_name="$2"
  shift 2
  local lines=("$@") i
  for i in "${!lines[@]}"; do
    $TMUX_BIN -L "$sock" set-option -g "status-format[$((i + 1))]" \
      "${lines[i]}" 2>/dev/null
  done
  # tmux spells a one-line status bar "on" and taller ones as a count.
  local height=on
  ((${#lines[@]})) && height=$((${#lines[@]} + 1))
  $TMUX_BIN -L "$sock" set-option -t "$session_name" status "$height" 2>/dev/null
}

# Whether to nag about --install-claude in the status bar: only while Claude
# Code is actually running in this session and the integration is not live.
#
# The trigger is a running process, not an installed binary or an existing
# ~/.claude — plenty of people never touch Claude Code, and a permanent hint
# in every session for a feature they do not want is worse than no hint. It
# also makes the hint self-timing: it appears within a poll of starting
# claude, which is exactly when it is actionable, and goes away again when
# the integration is registered.
function claude_hint_wanted {
  pgrep -u "$(id -u)" -x claude >/dev/null 2>&1 || return 1
  ! claude_integration_active
}

# Locate the directory holding the Claude Code assets (claude/hooks and
# skills/), so --install-claude works from an installed copy and not only from
# a git checkout. Candidates, in order: an explicit SINTERACTIVE_SHARE, the
# share dir alongside the installed script (bin/../share/sinteractive, which
# covers both ~/.local and /usr/local), and the script's own directory, which
# is the checkout case. Echoes the root and returns 0; returns 1 if none has
# the assets.
#
# Both layouts are identical below the root, so there is one code path rather
# than one per install flavour.
function find_claude_assets {
  local self dir candidates=()
  self=$(realpath "${BASH_SOURCE[0]}" 2>/dev/null) || self="${BASH_SOURCE[0]}"
  dir=$(dirname "$self")

  [[ -n "${SINTERACTIVE_SHARE:-}" ]] && candidates+=("${SINTERACTIVE_SHARE}")
  candidates+=("${dir}/../share/sinteractive")
  candidates+=("${dir}")

  local root
  for root in "${candidates[@]}"; do
    # bodhi-compute is the probe rather than skills/ itself: an empty skills/
    # directory left behind by a half-finished install would otherwise pass,
    # and this one has shipped since the assets existed.
    if [[ -d "${root}/claude/hooks" && -d "${root}/skills/bodhi-compute" ]]; then
      printf '%s' "$root"
      return 0
    fi
  done
  return 1
}

# Register the hooks in the user's Claude Code settings, additively.
#
# Editing settings.json is only safe with a real JSON parser: it is the user's
# file, it usually carries hooks and settings of their own, and a rewrite that
# got it wrong would silently disable all of them. So jq does this merge or
# nobody does — returning 1 without it, which the caller turns back into the
# printed block.
#
# The merge is additive and idempotent. Entries are appended to whatever
# .hooks already holds, and one is skipped when a hook script of that name is
# already registered in settings.json or settings.local.json. Matching is by
# script name rather than by the whole command, so a hand-edited path or a
# dropped `bash ` prefix still counts as registered, and a half-registered
# pair gets only its missing half. When the merge changes nothing, nothing is
# written.
#
# Return codes: 0 merged (or already registered), 1 no jq, 2 refused.
function register_claude_hooks {
  local claude_dir="$1" snippet="$2"
  local settings="${claude_dir}/settings.json"
  local other="${claude_dir}/settings.local.json"

  command -v jq >/dev/null 2>&1 || return 1
  [[ -r "$snippet" ]] || return 1

  # A settings.json that does not parse is not something to rewrite: the user
  # has an editing problem already, and merging into it would bury it.
  if [[ -s "$settings" ]] && ! jq -e . "$settings" >/dev/null 2>&1; then
    echo 1>&2 "${C_ERR}${C_BOLD}${PROG}:${C_RST}${C_ERR} ${settings} is not valid JSON, so it was left alone.${C_RST}"
    return 2
  fi
  # The .local variant is read only to see what is already registered there,
  # so an unreadable one costs nothing but that knowledge.
  if [[ ! -s "$other" ]] || ! jq -e . "$other" >/dev/null 2>&1; then
    other=/dev/null
  fi

  # Follow a symlinked settings.json (dotfile repos do this) so the merge
  # lands on the real file instead of replacing the link with a copy.
  if [[ -L "$settings" ]]; then
    local target
    target=$(readlink -f "$settings" 2>/dev/null)
    [[ -n "$target" ]] && settings="$target"
  fi

  local base
  if [[ -s "$settings" ]]; then
    base=$(cat "$settings") || return 2
  else
    base='{}'
  fi

  # $add is the snippet, $other the .local settings; $registered is every
  # sinteractive hook script named anywhere in either existing file.
  local program='
    def hookscripts:
      [ .. | objects | .command? | strings
        | select(test("sinteractive-[A-Za-z0-9._-]*\\.sh"))
        | capture("(?<n>sinteractive-[A-Za-z0-9._-]*\\.sh)").n ];
    ( [ (.hooks // {} | hookscripts)[] ]
      + [ ($other[0].hooks // {} | hookscripts)[] ] ) as $registered
    | reduce ($add[0].hooks | to_entries[]) as $event (.;
        [ $event.value[]
          | select( (hookscripts
                     | any(. as $s | ($registered | index($s)) != null)) | not ) ] as $new
        | if ($new | length) == 0 then .
          else .hooks[$event.key] = ((.hooks[$event.key] // []) + $new) end )'

  local tmp
  tmp=$(mktemp "${settings}.XXXXXX") || return 2

  if ! jq --slurpfile add "$snippet" --slurpfile other "$other" \
       "$program" <<<"$base" >"$tmp" 2>/dev/null ||
     ! jq -e 'type == "object"' "$tmp" >/dev/null 2>&1; then
    rm -f "$tmp"
    echo 1>&2 "${C_ERR}${C_BOLD}${PROG}:${C_RST}${C_ERR} could not merge into ${settings}, so it was left alone.${C_RST}"
    return 2
  fi

  # Compared as JSON rather than as text, so reformatting alone never counts
  # as a change worth writing.
  if jq -e --slurpfile new "$tmp" '. == $new[0]' <<<"$base" >/dev/null 2>&1; then
    rm -f "$tmp"
    echo "${C_OK}✓${C_RST} ${C_DIM}The hooks are already registered; your settings were left alone.${C_RST}"
    return 0
  fi

  local backup=''
  if [[ -f "$settings" ]]; then
    backup="${settings}.bak-$(date +%Y%m%d%H%M%S)"
    if ! cp -p "$settings" "$backup"; then
      rm -f "$tmp"
      return 2
    fi
    chmod --reference="$settings" "$tmp" 2>/dev/null || chmod 0644 "$tmp"
  else
    chmod 0644 "$tmp"
  fi

  if ! mv "$tmp" "$settings"; then
    rm -f "$tmp"
    return 2
  fi

  echo "${C_OK}✓${C_RST} Registered the hooks in ${C_ID}${settings}${C_RST}"
  [[ -n "$backup" ]] && echo "  ${C_DIM}the previous version is at ${backup}${C_RST}"
  return 0
}

# Install the Claude Code skills and hooks into the user's ~/.claude, from
# wherever this copy of sinteractive keeps its assets. Skills and hooks are
# per-user, so this is the same work whoever runs it.
#
# The hooks are registered for you when jq is available (see
# register_claude_hooks); without it the block is printed to merge by hand,
# because rewriting the user's settings.json with string surgery in bash would
# risk silently disabling every setting in it.
function install_claude {
  init_colors 1
  local assets
  if ! assets=$(find_claude_assets); then
    echo 1>&2 "${C_ERR}${C_BOLD}${PROG}:${C_RST}${C_ERR} could not find the Claude Code assets.${C_RST}"
    echo 1>&2 ''
    echo 1>&2 "${C_DIM}Looked for claude/hooks and skills/ beside this script and in${C_RST}"
    echo 1>&2 "${C_DIM}its ../share/sinteractive. If sinteractive was installed without${C_RST}"
    echo 1>&2 "${C_DIM}them, reinstall from a checkout (make install), or point${C_RST}"
    echo 1>&2 "${C_DIM}SINTERACTIVE_SHARE at a checkout:${C_RST}"
    echo 1>&2 ''
    echo 1>&2 "  ${C_KEY}SINTERACTIVE_SHARE=/path/to/sinteractive ${PROG} --install-claude${C_RST}"
    exit 1
  fi

  local claude_dir="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
  mkdir -p "${claude_dir}/hooks" || exit 1

  # Every skill shipped beside the script, rather than a list to keep in sync
  # here: adding one is then a matter of dropping a directory into skills/.
  local skill name names=()
  for skill in "${assets}"/skills/*/SKILL.md; do
    [[ -e "$skill" ]] || continue
    name=$(basename "$(dirname "$skill")")
    mkdir -p "${claude_dir}/skills/${name}" || exit 1
    cp "$skill" "${claude_dir}/skills/${name}/SKILL.md" || exit 1
    names+=("$name")
  done
  local hook
  for hook in "${assets}"/claude/hooks/*.sh; do
    [[ -e "$hook" ]] || continue
    install -m 0755 "$hook" "${claude_dir}/hooks/" || exit 1
  done

  # Name what landed rather than counting it: the point of the line is to say
  # which skills this copy of sinteractive carries, which is what differs
  # between a current install and a stale one.
  local list=''
  ((${#names[@]})) && printf -v list ', %s' "${names[@]}"
  echo "${C_OK}✓${C_RST} Installed the Claude Code hooks and skills (${C_KEY}${list:2}${C_RST}) into ${C_ID}${claude_dir}${C_RST}"
  echo "  ${C_DIM}from ${assets}${C_RST}"
  echo ''

  local rc=0
  register_claude_hooks "${claude_dir}" \
    "${assets}/claude/settings-snippet.json" || rc=$?
  if ((rc == 0)); then
    echo ''
    exit 0
  fi

  echo "${C_WARN}The hooks only take effect once they are registered.${C_RST} Merge this into"
  echo "${C_ID}${claude_dir}/settings.json${C_RST} (keeping any hooks already there):"
  echo ''
  if [[ -r "${assets}/claude/settings-snippet.json" ]]; then
    sed 's/^/  /' "${assets}/claude/settings-snippet.json"
  fi
  echo ''
  if ((rc == 1)); then
    echo "${C_DIM}With jq installed (\`pixi global install jq\`, or your package${C_RST}"
    echo "${C_DIM}manager) --install-claude does that merge for you.${C_RST}"
    echo ''
  fi
  exit 0
}

# Extract the effective partition name from the processed argument list.
function get_partition_from_args {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --partition=*)
      echo "${1#--partition=}"
      return
      ;;
    -p)
      echo "${2:-}"
      return
      ;;
    *)
      shift
      ;;
    esac
  done
  echo "interactive"
}

# Extract the effective --time / -t value from the processed argument list.
# Echoes the value (e.g. "24:00:00", "1-12:00:00", "120") and returns 0; if
# no time is set, returns 1.
function extract_time_from_args {
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --time=*)
      echo "${1#--time=}"
      return 0
      ;;
    --time)
      echo "${2:-}"
      return 0
      ;;
    -t)
      echo "${2:-}"
      return 0
      ;;
    -t=*)
      echo "${1#-t=}"
      return 0
      ;;
    *)
      shift
      ;;
    esac
  done
  return 1
}

# Whole seconds back to the D-HH:MM:SS Slurm accepts, dropping the day field
# when there is none. The inverse of slurm_time_to_seconds, used when a
# request is trimmed to fit before maintenance.
function seconds_to_slurm_time {
  local s=${1:-0} d h m
  ((s < 0)) && s=0
  d=$((s / 86400))
  s=$((s % 86400))
  h=$((s / 3600))
  m=$(((s % 3600) / 60))
  s=$((s % 60))
  if ((d > 0)); then
    printf '%d-%02d:%02d:%02d' "$d" "$h" "$m" "$s"
  else
    printf '%02d:%02d:%02d' "$h" "$m" "$s"
  fi
}

# Rewrite the effective walltime in an already-processed argument list,
# NUL-delimited so values with spaces survive the round trip.
#
# Both spellings have to be handled: --time collapses to --time=VALUE during
# normalisation, but -t keeps its value as a separate argument, so a
# substitution over the array would silently miss half the callers.
function replace_time_in_args {
  local new="$1"
  shift
  local rebuilt=() skip=0 a
  for a in "$@"; do
    if ((skip)); then
      skip=0
      continue
    fi
    case "$a" in
    --time=*) rebuilt+=("--time=${new}") ;;
    -t)
      rebuilt+=(-t "$new")
      skip=1
      ;;
    -t=*) rebuilt+=("-t=${new}") ;;
    *) rebuilt+=("$a") ;;
    esac
  done
  printf '%s\0' "${rebuilt[@]}"
}

# Convert a SLURM time string to whole seconds. Echoes the integer and returns
# 0 on success; returns 1 if the format isn't recognized (caller should fail
# open).
function slurm_time_to_seconds {
  local t=$1
  local d=0 h=0 m=0 s=0
  if [[ "$t" =~ ^([0-9]+)-([0-9]+):([0-9]+):([0-9]+)$ ]]; then
    d=${BASH_REMATCH[1]}
    h=${BASH_REMATCH[2]}
    m=${BASH_REMATCH[3]}
    s=${BASH_REMATCH[4]}
  elif [[ "$t" =~ ^([0-9]+)-([0-9]+):([0-9]+)$ ]]; then
    d=${BASH_REMATCH[1]}
    h=${BASH_REMATCH[2]}
    m=${BASH_REMATCH[3]}
  elif [[ "$t" =~ ^([0-9]+)-([0-9]+)$ ]]; then
    d=${BASH_REMATCH[1]}
    h=${BASH_REMATCH[2]}
  elif [[ "$t" =~ ^([0-9]+):([0-9]+):([0-9]+)$ ]]; then
    h=${BASH_REMATCH[1]}
    m=${BASH_REMATCH[2]}
    s=${BASH_REMATCH[3]}
  elif [[ "$t" =~ ^([0-9]+):([0-9]+)$ ]]; then
    m=${BASH_REMATCH[1]}
    s=${BASH_REMATCH[2]}
  elif [[ "$t" =~ ^([0-9]+)$ ]]; then
    m=${BASH_REMATCH[1]}
  else
    return 1
  fi
  echo $((d * 86400 + 10#$h * 3600 + 10#$m * 60 + 10#$s))
}

# Format seconds as a short human duration like "1d 2h 5m" or "45m".
function format_short_duration {
  local secs=$1
  local d=$((secs / 86400))
  local h=$(((secs % 86400) / 3600))
  local m=$(((secs % 3600) / 60))
  local out=""
  ((d > 0)) && out+="${d}d "
  ((h > 0)) && out+="${h}h "
  ((m > 0)) && out+="${m}m"
  # Below one minute, minute granularity reads as a confusing "0m".
  ((d == 0 && h == 0 && m == 0)) && out="${secs}s"
  echo "${out% }"
}

# The earliest MAINT reservation still in the future, as "name start_epoch".
# Fails when scontrol is unavailable, none is queued, or none parses — every
# caller then behaves as if there were no window, which is what a cluster
# without maintenance reservations should see.
function next_maintenance_window {
  local resv_out
  resv_out=$(scontrol show reservation -o 2>/dev/null) || return 1
  [[ -z "$resv_out" ]] && return 1
  [[ "$resv_out" == "No reservations"* ]] && return 1

  local now_epoch best_epoch=0 best_name=""
  now_epoch=$(date +%s)

  local line start_str start_epoch
  while IFS= read -r line; do
    [[ "$line" =~ Flags=[^[:space:]]*MAINT ]] || continue
    [[ "$line" =~ StartTime=([^[:space:]]+) ]] || continue
    start_str=${BASH_REMATCH[1]}
    start_epoch=$(date -d "$start_str" +%s 2>/dev/null) || continue
    ((start_epoch > now_epoch)) || continue
    if ((best_epoch == 0 || start_epoch < best_epoch)); then
      best_epoch=$start_epoch
      if [[ "$line" =~ ReservationName=([^[:space:]]+) ]]; then
        best_name=${BASH_REMATCH[1]}
      fi
    fi
  done <<<"$resv_out"

  ((best_epoch == 0)) && return 1
  # Newline-terminated: the caller reads this with `read`, which reports
  # failure on an unterminated final line even after setting the variables —
  # and the caller treats that failure as "no maintenance window".
  printf '%s %s\n' "${best_name:-maintenance}" "$best_epoch"
}

# Smallest session worth starting when maintenance is close. Below this the
# allocation is more nuisance than help, so the launch is refused instead.
MAINT_MIN_SESSION=600
# Margin between the session's end and the reservation's start. Slurm will not
# schedule a job that runs into the window at all, so asking for the whole gap
# is a race against the seconds spent submitting.
MAINT_MARGIN=300

# Right-size --time so the session ends before the next maintenance window.
#
# This used to refuse the launch and print the shorter command to run instead,
# which is correct but hands the arithmetic back to the user at exactly the
# moment they wanted a shell. Slurm will not start a job that overlaps the
# reservation — it defers it until the window closes, which can be a day or
# more — so a session asked for at the default day length simply stops working
# as maintenance approaches, with no obvious reason.
#
# Now the request is trimmed to fit and the session says so, in the notice
# line and at launch. Echoes "fitted_secs name start_epoch original_time" when
# it trimmed, nothing when there was no conflict. Returns 1 only when the
# remaining gap is too small to be worth a session at all.
function fit_maintenance_window {
  # An explicit --reservation means the user has arranged to run inside the
  # window; that is theirs to get right.
  local arg
  for arg in "$@"; do
    case "$arg" in
    --reservation=* | --reservation) return 0 ;;
    esac
  done

  local name start_epoch
  read -r name start_epoch < <(next_maintenance_window) || return 0
  [[ -n "${start_epoch:-}" ]] || return 0

  local time_str time_secs now_epoch
  time_str=$(extract_time_from_args "$@") || return 0
  time_secs=$(slurm_time_to_seconds "$time_str") || return 0
  now_epoch=$(date +%s)

  local job_end=$((now_epoch + time_secs))
  ((job_end <= start_epoch)) && return 0

  local gap_secs=$((start_epoch - now_epoch))
  local fit_secs=$((gap_secs - MAINT_MARGIN))

  if ((fit_secs < MAINT_MIN_SESSION)); then
    local maint_when
    maint_when=$(date -d "@$start_epoch" "+%a %b %-d %H:%M")
    echo 1>&2 ""
    echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} maintenance starts too soon to open a session.${C_RST}"
    echo 1>&2 ""
    printf 1>&2 "  ${C_KEY}%-13s${C_RST} ${C_ID}%s${C_RST}\n" 'Reservation:' "${name}"
    printf 1>&2 "  ${C_KEY}%-13s${C_RST} %s ${C_DIM}(in %s)${C_RST}\n" \
      'Starts:' "${maint_when}" "$(format_short_duration $gap_secs)"
    echo 1>&2 ""
    echo 1>&2 "${C_DIM}Slurm won't schedule a job that runs into the window, and what is${C_RST}"
    echo 1>&2 "${C_DIM}left before it is under $(format_short_duration $MAINT_MIN_SESSION). Wait for the reservation to end.${C_RST}"
    echo 1>&2 ""
    echo 1>&2 "${C_DIM}See 'scontrol show reservation' for full details.${C_RST}"
    echo 1>&2 ""
    return 1
  fi

  printf '%s %s %s %s' "$fit_secs" "$name" "$start_epoch" "$time_str"
}

# Check if submitting another job would exceed the QOS MaxJobsPerUser limit.
# Only checks when targeting the interactive partition.
# Falls through silently if sacctmgr or squeue are unavailable.
function check_job_limit {
  local partition="$1"

  # Only enforce for the interactive partition
  if [[ "$partition" != "interactive" ]]; then
    return 0
  fi

  # Query QOS limit dynamically; fail open if sacctmgr unavailable
  local max_jobs
  max_jobs=$(sacctmgr show qos interactive format=MaxJobsPerUser --noheader --parsable2 2>/dev/null)
  if [[ $? -ne 0 ]] || [[ -z "$max_jobs" ]]; then
    return 0
  fi

  max_jobs=$(echo "$max_jobs" | xargs)

  if ! [[ "$max_jobs" =~ ^[0-9]+$ ]]; then
    return 0
  fi

  # Count current running + pending jobs on the interactive partition
  local current_jobs
  current_jobs=$(squeue --me --partition=interactive --states=RUNNING,PENDING --noheader 2>/dev/null | wc -l)
  if [[ $? -ne 0 ]]; then
    return 0
  fi

  current_jobs=$(echo "$current_jobs" | xargs)

  if ((current_jobs >= max_jobs)); then
    echo 1>&2 ""
    echo 1>&2 "${C_ERR}${C_BOLD}Error:${C_RST}${C_ERR} You already have ${current_jobs}/${max_jobs} interactive jobs (the maximum allowed).${C_RST}"
    echo 1>&2 ""

    local lines
    lines=$(squeue --me --partition=interactive --states=RUNNING,PENDING --noheader \
      --Format=JobID:12,Name:20,NodeList:16,State:10,TimeUsed:12,TimeLimit:12 2>/dev/null)

    if [[ -n "$lines" ]]; then
      echo 1>&2 "${C_DIM}Your current interactive jobs:${C_RST}"
      echo 1>&2 ""
      printf 1>&2 "  ${C_DIM}%-10s  %-18s  %-14s  %-9s  %-10s  %-10s${C_RST}\n" \
        'JOBID' 'NAME' 'NODE' 'STATE' 'ELAPSED' 'TIMELIMIT'
      local state_c
      while IFS= read -r line; do
        read -r jobid name node state elapsed limit <<<"$line"
        # A PENDING job holds a slot just as a RUNNING one does, which is the
        # whole reason this table is here — so it is flagged, not hidden.
        state_c="${C_WARN}"
        [[ "$state" == 'RUNNING' ]] && state_c="${C_OK}"
        printf 1>&2 "  ${C_ID}%-10s${C_RST}  ${C_BOLD}%-18s${C_RST}  ${C_ID}%-14s${C_RST}  ${state_c}%-9s${C_RST}  %-10s  %-10s\n" \
          "$jobid" "$name" "$node" "$state" "$elapsed" "$limit"
      done <<<"$lines"
      echo 1>&2 ""
    fi

    echo 1>&2 "${C_KEY}To reattach to an existing session:${C_RST}"
    local jobids
    jobids=$(squeue --me --partition=interactive --states=RUNNING --noheader --Format=JobID 2>/dev/null | xargs)
    for jid in $jobids; do
      echo 1>&2 "  sinteractive --attach ${C_ID}${jid}${C_RST}"
    done
    echo 1>&2 ""
    echo 1>&2 "${C_KEY}To free a slot, cancel a session:${C_RST}"
    jobids=$(squeue --me --partition=interactive --states=RUNNING,PENDING --noheader --Format=JobID 2>/dev/null | xargs)
    for jid in $jobids; do
      echo 1>&2 "  scancel ${C_ID}${jid}${C_RST}"
    done
    echo 1>&2 ""
    return 1
  fi

  return 0
}

# Resolve a JOBID-or-NAME target to a job id. Numeric targets pass through;
# names are matched against the Comment marker set at submit time. Prints the
# job id on stdout; errors (to stderr) and returns nonzero on no match or
# ambiguity, so call as: jobid=$(resolve_session_jobid "$target") || exit 1
function resolve_session_jobid {
  local target=$1

  if [[ "${target}" =~ ^[0-9]+$ ]]; then
    echo "${target}"
    return 0
  fi

  local matches
  matches=$(squeue --me --states RUNNING,PENDING --noheader \
    --Format=JobID:12,Comment:80 2>/dev/null |
    awk -v n="sinteractive:${target}" '$2 == n {print $1}')
  local count
  count=$(printf '%s\n' "${matches}" | grep -c .)
  if [[ "${count}" -eq 0 ]]; then
    echo 1>&2 "${C_ERR}${C_BOLD}${PROG}:${C_RST}${C_ERR} no sinteractive session named '${target}'${C_RST}"
    echo 1>&2 "${C_DIM}Run 'sinteractive --list' to see available sessions.${C_RST}"
    return 1
  elif [[ "${count}" -gt 1 ]]; then
    echo 1>&2 "${C_ERR}${C_BOLD}${PROG}:${C_RST}${C_ERR} multiple sinteractive sessions named '${target}':${C_RST}"
    echo 1>&2 "  ${C_ID}$(echo ${matches} | xargs)${C_RST}"
    echo 1>&2 "${C_DIM}Specify a JOBID instead.${C_RST}"
    return 1
  fi
  echo "${matches}"
}

# Cancel a session by JOBID or NAME (scancel with name resolution). Reports
# what was cancelled; exits. Works from inside a session too — cancelling the
# session you are in ends it, like walltime running out.
function cancel_session {
  local target=$1
  local jobid

  jobid=$(resolve_session_jobid "${target}") || exit 1

  # Describe the session before it disappears from squeue.
  local line comment node='' name=''
  line=$(squeue --jobs "${jobid}" --noheader -o '%k|%N' 2>/dev/null)
  if [[ -n "$line" ]]; then
    IFS='|' read -r comment node <<<"$line"
    [[ "$comment" =~ ^sinteractive:(.+)$ ]] && name="${BASH_REMATCH[1]}"
  fi

  local err
  if ! err=$(scancel "${jobid}" 2>&1); then
    echo 1>&2 "${C_ERR}${C_BOLD}${PROG}:${C_RST}${C_ERR} could not cancel job ${jobid}: ${err:-scancel failed}${C_RST}"
    exit 1
  fi

  local desc="session ${jobid}"
  [[ -n "$name" ]] && desc+=" (${name})"
  echo 1>&2 "${C_OK}✓${C_RST} Cancelled ${desc}${node:+ on ${C_ID}${node}${C_RST}}."
  exit 0
}

function reattach {
  local target=$1
  local jobid

  # No target: attach to the only running session. With none, say how to
  # start one; with several, show the ready-to-run choices.
  if [[ -z "${target}" ]]; then
    local lines
    lines=$(squeue --me --states RUNNING --noheader -o '%i|%k|%N|%M' 2>/dev/null |
      awk -F'|' '$2 == "sinteractive" || index($2, "sinteractive:") == 1')
    if [[ -z "$lines" ]]; then
      echo 1>&2 "${C_ERR}${C_BOLD}${PROG}:${C_RST}${C_ERR} no running sinteractive sessions to attach to.${C_RST}"
      echo 1>&2 "${C_DIM}Start one with 'sinteractive'.${C_RST}"
      exit 1
    fi
    local count
    count=$(grep -c . <<<"$lines")
    if ((count > 1)); then
      echo 1>&2 "${C_WARN}${C_BOLD}${PROG}:${C_RST}${C_WARN} you have ${count} running sessions — pick one:${C_RST}"
      local ljob lcomment lnode lelapsed lname
      while IFS='|' read -r ljob lcomment lnode lelapsed; do
        lname=''
        [[ "$lcomment" =~ ^sinteractive:(.+)$ ]] && lname="${BASH_REMATCH[1]}"
        printf 1>&2 "  sinteractive --attach ${C_ID}%-18s${C_RST} ${C_DIM}# job %s on %s, up %s${C_RST}\n" \
          "${lname:-${ljob}}" "$ljob" "$lnode" "$lelapsed"
      done <<<"$lines"
      exit 1
    fi
    target="${lines%%|*}"
  fi

  jobid=$(resolve_session_jobid "${target}") || exit 1

  local sock="sinteractive-${jobid}"

  # Verify the job is still running
  local state
  state=$(squeue --jobs "${jobid}" --states RUNNING --noheader --Format state 2>/dev/null | xargs)
  if [[ "${state}" != 'RUNNING' ]]; then
    echo 1>&2 "${C_ERR}${C_BOLD}${PROG}:${C_RST}${C_ERR} job ${jobid} is not running (state: ${state:-unknown})${C_RST}"
    exit 1
  fi

  echo 1>&2 "${C_DIM}Reattaching to sinteractive session${C_RST} ${C_ID}${jobid}${C_RST}${C_DIM}...${C_RST}"
  exec srun --overlap --jobid="${jobid}" --pty \
    $TMUX_BIN -L "$sock" -u attach-session -t "sinteractive-${jobid}"
}

# Render the in-session help modal. Runs inside a tmux display-popup on the
# compute node (invoked as "help-popup JOBID" via the spooled batch script).
# Job info is queried live so time remaining is current each time the popup
# opens; any keypress closes it. Degrades to '-' if squeue is unavailable.
function show_help_popup {
  local jobid="${1:-}"

  local node='-' limit='-' remaining='-'
  local info
  info=$(squeue --jobs "$jobid" --noheader \
    --Format=EndTime:24,NodeList:20,TimeLimit:12 2>/dev/null | xargs)
  if [[ -n "$info" ]]; then
    local end_str
    read -r end_str node limit <<<"$info"
    local end_epoch
    end_epoch=$(date -d "$end_str" +%s 2>/dev/null)
    if [[ -n "$end_epoch" ]]; then
      local secs=$((end_epoch - $(date +%s)))
      ((secs < 0)) && secs=0
      remaining=$(format_short_duration "$secs")
    fi
  fi

  # ANSI styles; the popup always renders on a terminal. Yellow keys echo the
  # status-bar highlight (colour229).
  local rst=$'\e[0m' bold=$'\e[1m' dim=$'\e[2m' url=$'\e[4;36m'
  local hdr=$'\e[1;36m' key=$'\e[1;33m'
  # OSC 8 hyperlink so the docs URL is clickable in terminals that support it
  # (needs the hyperlinks terminal-feature set in start_tmux to pass through).
  #
  # $VERSION here comes from Slurm's spooled copy of the script, so it reports
  # the version that LAUNCHED this session — which is the useful number, and
  # can differ from whatever is installed on the login node now.
  local docs='https://tinyurl.com/2s45khbx'
  local lnk=$'\e]8;;'"$docs"$'\e\\' lnk_end=$'\e]8;;\e\\'

  cat <<EOF

  ${bold}Job ${jobid:-?} on ${node}${rst} | ${key}${remaining}${rst} remaining ${dim}(limit ${limit})${rst}

  ${hdr}Session${rst}
    Detach (keeps job running)   ${key}Ctrl+b d${rst}
    Name/rename session          ${key}Ctrl+b \$${rst}
    Reattach from login node     ${key}sinteractive --attach ${jobid:-JOBID}${rst}
    List your sessions           ${key}sinteractive --list${rst}
    End session and job          ${key}exit${rst} ${dim}(in all panes)${rst}

  ${hdr}tmux basics${rst}
    Split pane (top/bottom)      ${key}Ctrl+b "${rst}
    Split pane (side/side)       ${key}Ctrl+b %${rst}
    Switch panes                 ${key}Ctrl+b arrow-key${rst}

  ${hdr}Scrollback & copy (vi keys)${rst}
    Enter copy mode              ${key}Ctrl+b [${rst}  ${dim}(q exits)${rst}
    Start selection              ${key}Space${rst}  ${dim}(V = whole lines)${rst}
    Copy and exit                ${key}Enter${rst}  ${dim}(lands in your local clipboard)${rst}
    Paste into pane              ${key}Ctrl+b ]${rst}
    Search up / down             ${key}?${rst} / ${key}/${rst}

  Docs: ${url}${lnk}${docs}${lnk_end}${rst}   ${dim}sinteractive ${VERSION}${rst}

  ${dim}Press any key to close.${rst}
EOF
  read -rsn1
}

# Flash a message in the status line of every attached client. Handlers run
# via run-shell with no client context, so target clients explicitly; with no
# clients attached (detached session) this is a silent no-op.
function display_to_clients {
  local jobid="$1" delay="$2" msg="$3"
  local sock="sinteractive-${jobid}"
  local client
  while IFS= read -r client; do
    $TMUX_BIN -L "$sock" display-message -d "$delay" -c "$client" "$msg"
  done < <($TMUX_BIN -L "$sock" list-clients -F '#{client_name}' 2>/dev/null)
}

# Name or rename a running session in place (bound to prefix + $ in
# start_tmux). Runs on the compute node via run-shell. Updates, in order:
# the Slurm Comment marker (what --attach/--list/--status resolve against),
# the Slurm job name (cosmetic, shows in squeue), and the tmux session
# environment SINTERACTIVE_NAME (drives the status bar, terminal title, and
# state file; new panes inherit it). Shells already running keep their old
# SINTERACTIVE_NAME — deliberately no send-keys, which could type into a
# foreground program.
function rename_session {
  local jobid="$1"
  local new_name="${2:-}"
  local sock="sinteractive-${jobid}"
  local session="sinteractive-${jobid}"

  # Bare Enter at the prompt = cancel.
  [[ -z "$new_name" ]] && return 0

  if ! [[ "$new_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    display_to_clients "$jobid" 5000 \
      "rename failed: name must contain only letters, digits, '.', '_', '-'"
    return 1
  fi

  # Duplicate-name guard, excluding this job so renaming to the current name
  # is a clean no-op. squeue failure fails open, matching the submit side.
  local existing
  existing=$(squeue --me --states RUNNING,PENDING --noheader \
    --Format=JobID:12,Comment:80 2>/dev/null |
    awk -v n="sinteractive:${new_name}" -v me="$jobid" '$2 == n && $1 != me {print $1}')
  if [[ -n "$existing" ]]; then
    display_to_clients "$jobid" 5000 \
      "rename failed: '${new_name}' is already used by job $(echo ${existing} | xargs)"
    return 1
  fi

  # Comment first: it is what name-based lookups match on. If it fails
  # (e.g. slurmctld unreachable), stop before touching the tmux env so
  # Slurm and tmux stay consistent on the old name.
  local err
  if ! err=$(scontrol update JobId="$jobid" Comment="sinteractive:${new_name}" 2>&1); then
    display_to_clients "$jobid" 5000 "rename failed: ${err}"
    return 1
  fi
  # Job name is cosmetic (squeue display); best-effort.
  scontrol update JobId="$jobid" Name="sint-${new_name}" 2>/dev/null || true

  $TMUX_BIN -L "$sock" set-environment -t "$session" SINTERACTIVE_NAME "$new_name"

  # Poke status_dot_loop so the state file refreshes next tick instead of
  # waiting out its write cache. A poke re-checks the deadline too, since a
  # write is only made from a freshly confirmed end time.
  touch "${HOME}/.cache/sinteractive/${jobid}.poke" 2>/dev/null || true

  display_to_clients "$jobid" 2000 "session renamed to '${new_name}'"
}

# Ask Slurm for this job's end time. Assigns end_epoch, end_checked (when the
# deadline was last confirmed) and end_query (when it was last attempted) in
# status_dot_loop, whose locals are visible here through bash's dynamic
# scoping — this is a helper for that one loop, not a general-purpose
# function. Recording the attempt separately from the success lets the caller
# rate-limit a failing scheduler. Returns 0 when the end time was confirmed,
# 1 on a transient failure (squeue unreachable, EndTime Unknown/UNLIMITED),
# leaving the previous end_epoch alone so the countdown keeps running.
function refresh_end_epoch {
  local now=$1
  local end_str new_epoch
  end_query=$now
  end_str=$(squeue --jobs "${SLURM_JOB_ID}" --noheader --Format EndTime 2>/dev/null | xargs)
  [[ -n "$end_str" ]] || return 1
  new_epoch=$(date -d "$end_str" +%s 2>/dev/null) || return 1
  end_epoch=$new_epoch
  end_checked=$now
  return 0
}

# Background updater for the status-bar glyph: a dot in the terminal's
# default foreground color (adapts to light/dark themes) while plenty of
# walltime remains, a pulsing yellow dot plus countdown once less than
# SINTERACTIVE_WARN_YELLOW seconds are left (default 1 hour), and a braille
# spinner blinking yellow/red with an M:SS countdown for the final
# SINTERACTIVE_WARN_RED seconds (default 10 minutes). (Braille cells are
# single-width everywhere; the quadrant clocks ◴◵◶◷ used previously are
# East Asian Ambiguous width and jitter in some fonts.) A few seconds
# before the limit it prints a notice in every pane and kills the session
# itself, so teardown runs the normal exit path (clean client detach, job
# COMPLETED) instead of Slurm's SIGTERM/SIGKILL tearing tmux down
# mid-frame. Replaces the old USR1-driven warning banner at the top of the
# pane. Runs until the tmux session ends; killed with the job's cgroup at
# teardown.
function status_dot_loop {
  local session_name="$1"
  local disp_name="${2:-}"
  local maint_spec="${3:-}"
  local sock="sinteractive-${SLURM_JOB_ID}"

  # Fixed for the life of the session: set at submit time when the request was
  # trimmed, empty otherwise.
  local maint_name='' maint_start=''
  if [[ -n "$maint_spec" ]]; then
    maint_name="${maint_spec%@*}"
    maint_start="${maint_spec##*@}"
  fi

  # How often the quota daemons are asked. Ten minutes by default: quota moves
  # slowly, the probe is nine TCP round-trips, and the cache is shared by every
  # session this user has open, so one of them polling is enough for all.
  local quota_poll="${SINTERACTIVE_QUOTA_POLL:-600}"
  ((quota_poll < 30)) && quota_poll=30

  local warn_yellow="${SINTERACTIVE_WARN_YELLOW:-3600}"
  local warn_red="${SINTERACTIVE_WARN_RED:-600}"
  # Seconds before the limit at which the session is shut down cleanly.
  # Env-tunable mainly for testing (e.g. SINTERACTIVE_GRACE=55 --time=1
  # fires the shutdown a few seconds after launch).
  local grace="${SINTERACTIVE_GRACE:-10}"
  # How often the end time is re-checked against Slurm and the state file
  # rewritten: two squeue calls a minute per session. Raise it where
  # scheduler traffic is a concern, at the cost of a walltime extension
  # taking that much longer to reach the cached file.
  local poll="${SINTERACTIVE_POLL:-30}"
  ((poll < 5)) && poll=5
  # Floor on scheduler queries however often the loop wakes: the final
  # countdown ticks ten times a second, and a pending write stays pending
  # until a query succeeds. Doubles as the window in which a confirmed end
  # time still counts as fresh enough to write.
  local end_min_gap=5

  # State file mirroring the countdown, so scripts and agents can poll the
  # time budget without hitting the scheduler. $HOME is shared, so it is
  # readable from the login node too. Removed at session teardown.
  local state_dir="${HOME}/.cache/sinteractive"
  local state_file="${state_dir}/${SLURM_JOB_ID}.json"
  mkdir -p "$state_dir"
  local host
  host=$(hostname -s)
  local state_written=0

  # Everything after the glyph is fixed; the loop only swaps the glyph and
  # appends a countdown. Must mirror the initial status-left in start_tmux.
  # The trailing conditional shows the session name when one is set; tmux
  # format lookup falls back to the session environment, so a prefix+$
  # rename (set-environment SINTERACTIVE_NAME) appears on the next redraw
  # without this loop rebuilding anything.
  # (The #, inside the conditional escapes the style comma, which would
  # otherwise terminate the branch.)
  local base=" #[dim]session#[default] #[fg=#2DBFB8,bold]${SLURM_JOB_ID}#[default] #[dim]|#[default] #[fg=#2DBFB8,bold]#{host_short}#[default]#{?SINTERACTIVE_NAME, #[dim]|#[default] #[fg=#2DBFB8#,bold]#{SINTERACTIVE_NAME}#[default],}"

  local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  local end_epoch='' end_query=0 end_checked=0 spin=0 belled=0 last=''
  local hint_shown=0 hint_checked=0 last_notice=''
  local quota_checked=0 quota_part='' maint_part=''
  maint_part=$(maint_notice_string "$maint_name" "$maint_start") || maint_part=''
  while $TMUX_BIN -L "$sock" has-session -t "$session_name" 2>/dev/null; do
    local now remaining
    # printf's builtin strftime — no date fork, which matters at the
    # 10 ticks/second cadence of the final countdown.
    printf -v now '%(%s)T' -1

    # A poke file (touched by rename_session, or by --refresh from the login
    # node) makes a write due on this tick instead of waiting out the poll
    # interval — and because a write is only made from a freshly confirmed
    # end time, a poke re-checks the deadline too. Zeroing state_written
    # rather than writing here keeps the request pending until one succeeds.
    if [[ -e "${state_file%.json}.poke" ]]; then
      rm -f "${state_file%.json}.poke"
      state_written=0
      # A poke also means "re-read the quota cache now". --check-quota writes
      # a fresh one and pokes every session, so an agent that has just deleted
      # something sees the warning clear on the next tick rather than at the
      # end of the ten-minute poll.
      quota_checked=0
    fi

    # Quota. The probe itself is only run when the shared cache has gone
    # stale, so N sessions still cost one probe per interval; reading the
    # cache is a file read and happens on the same slow cadence.
    if ((now - quota_checked >= quota_poll)); then
      quota_checked=$now
      local q_over=0 q_hard=0 q_over_kb=0 q_age=0
      if read -r q_over _ q_hard q_over_kb _ q_age < <(quota_cached) &&
        [[ -n "${q_over:-}" ]]; then
        ((q_age >= quota_poll)) && quota_probe >/dev/null 2>&1 &&
          read -r q_over _ q_hard q_over_kb _ q_age < <(quota_cached)
      else
        quota_probe >/dev/null 2>&1 &&
          read -r q_over _ q_hard q_over_kb _ q_age < <(quota_cached)
      fi
      quota_part=$(quota_notice_string \
        "${q_over:-0}" "${q_hard:-0}" "${q_over_kb:-0}") ||
        quota_part=''
    fi

    # Claude Code hint, on the same cadence as the scheduler poll rather than
    # the loop's tick (which reaches 10Hz in the final countdown). Only
    # re-read when the poll comes round, so a steady state costs one pgrep
    # per poll.
    if ((now - hint_checked >= poll)); then
      hint_checked=$now
      hint_shown=0
      claude_hint_wanted && hint_shown=1
    fi

    # The lines below the status bar, applied here rather than further down
    # so they are up on the first tick and stay up on a job whose end time
    # Slurm will not report (the no-deadline `continue` below). Only touched
    # when the text changes: growing and shrinking the status bar resizes
    # every pane in the session, so a steady state must not keep re-setting
    # it.
    local notice_lines=() line
    line=$(compose_notice "$quota_part" "$maint_part")
    [[ -n "$line" ]] && notice_lines+=("$line")
    line=$(hint_notice_string "$hint_shown") && notice_lines+=("$line")
    local notice="${notice_lines[*]}"
    if [[ "$notice" != "$last_notice" ]]; then
      apply_notice_lines "$sock" "$session_name" "${notice_lines[@]}"
      last_notice="$notice"
    fi

    # One cadence for both halves of the state file: ask Slurm for the end
    # time immediately before each write, so a `scontrol update TimeLimit`
    # lands within one poll interval and updated_epoch always means
    # "confirmed against Slurm at this time". A file that looks fresh while
    # carrying a five-minute-old deadline is worse than no file at all.
    if ((now - state_written >= poll && now - end_query >= end_min_gap)); then
      refresh_end_epoch "$now"
    fi
    # No parseable end time yet (UNLIMITED, squeue hiccup): leave the white
    # dot alone and try again later.
    if [[ -z "$end_epoch" ]]; then
      sleep 60
      continue
    fi

    remaining=$((end_epoch - now))
    ((remaining < 0)) && remaining=0

    # Write only on a deadline Slurm just confirmed, so every field in the
    # file was true as of updated_epoch and consumers can age it exactly
    # (remaining_seconds - (now - updated_epoch)). When squeue is unreachable
    # the file is left alone rather than restamped: it then ages honestly and
    # the documented staleness check (older than ~2 minutes -> fall back to
    # --status) fires, instead of a fresh timestamp vouching for a budget
    # nobody verified. The status bar keeps counting down from the last known
    # end time either way — best effort for humans, honesty for machines.
    # A failed query leaves state_written unadvanced, so the write stays due
    # and retries next tick. write-then-rename keeps reads atomic.
    if ((now - state_written >= poll && now - end_checked <= end_min_gap)); then
      state_written=$now
      # Re-read the name each write so a prefix+$ rename lands in the state
      # file; the tmux session environment is the source of truth. Keep the
      # captured value as fallback when the var was never set.
      local env_name
      if env_name=$($TMUX_BIN -L "$sock" show-environment -t "$session_name" SINTERACTIVE_NAME 2>/dev/null); then
        disp_name="${env_name#*=}"
      fi
      printf '{"job_id":%s,"name":%s,"node":"%s","end_epoch":%s,"remaining_seconds":%s,"updated_epoch":%s}\n' \
        "${SLURM_JOB_ID}" "$(json_string_or_null "$disp_name")" "$host" \
        "$end_epoch" "$remaining" "$now" >"${state_file}.tmp" &&
        mv -f "${state_file}.tmp" "$state_file"
    fi

    local glyph text sleep_for
    if ((remaining > warn_yellow)); then
      glyph='#[bold]●#[default]'
      text=''
      # Wake at the yellow boundary when it lands inside the normal cadence,
      # so the yellow phase starts on time (not a full sleep late — which in
      # short sessions skipped it entirely). Cap the sleep at half the poll
      # interval so the state file really is rewritten every poll seconds: a
      # sleep of exactly poll lands a hair late, the comparison reads one
      # short, and every write slips to the following tick — which is how a
      # 30-second cache had been behaving as a 60-second one.
      local green_sleep=$((poll / 2))
      ((green_sleep < 1)) && green_sleep=1
      sleep_for=$((remaining - warn_yellow < green_sleep ? remaining - warn_yellow : green_sleep))
      ((sleep_for < 1)) && sleep_for=1
      belled=0
    elif ((remaining > warn_red)); then
      # Pulse the dot bold/dim once a second — catches the eye without the
      # urgency of the red phase's spinner.
      if ((spin % 2)); then
        glyph='#[fg=yellow,dim]●#[default]'
      else
        glyph='#[fg=yellow,bold]●#[default]'
      fi
      spin=$((spin + 1))
      text=" #[dim]| $(format_short_duration "$remaining") left#[default]"
      sleep_for=1
      belled=0
    else
      # Ring the terminal bell once as the final countdown starts: writing
      # BEL to a pane's tty registers as a pane bell, which tmux forwards to
      # attached clients (default bell-action any), so the terminal tab gets
      # an attention badge even when the user is looking at another window.
      if ((!belled)); then
        # Confirm the deadline before crying wolf: an extension made moments
        # ago should cancel the alarm, not set it off. The bell cannot be
        # un-rung, so this one bypasses the rate floor; it fires once per
        # entry into the red phase and remaining only decreases, so it cannot
        # loop. A failed query rings — fail loud, not silent. The continue
        # also drops the spurious red spinner: the next tick recomputes from
        # the new end_epoch and lands in the yellow or green branch.
        if refresh_end_epoch "$now" && ((end_epoch - now > warn_red)); then
          continue
        fi
        belled=1
        local pane_tty
        while read -r pane_tty; do
          printf '\a' >"$pane_tty" 2>/dev/null || true
        done < <($TMUX_BIN -L "$sock" list-panes -s -t "$session_name" -F '#{pane_tty}')
      fi
      # Almost out of time: end the session ourselves so teardown runs the
      # normal exit path (farewell in every pane, clean client detach, job
      # COMPLETED via the session-closed hook) instead of Slurm's
      # SIGTERM/SIGKILL tearing tmux down mid-frame.
      if ((remaining <= grace)); then
        # end_epoch can be a poll interval old; re-check so a timelimit
        # extension inside that window is honored rather than cut short. A
        # failed query leaves end_epoch alone and the session shuts down:
        # fail safe.
        refresh_end_epoch "$now"
        if ((end_epoch - now > grace)); then
          continue
        fi
        $TMUX_BIN -L "$sock" set-option -t "$session_name" status-left \
          " #[fg=red,bold]●#[default]${base} #[fg=red,bold]| time's up — ending session#[default] "
        local pane_tty
        while read -r pane_tty; do
          printf '\r\n\033[1;31m[sinteractive] walltime reached — ending session\033[0m\r\n' \
            >"$pane_tty" 2>/dev/null || true
        done < <($TMUX_BIN -L "$sock" list-panes -s -t "$session_name" -F '#{pane_tty}')
        sleep 2
        $TMUX_BIN -L "$sock" kill-session -t "$session_name" 2>/dev/null
        break
      fi
      # Spin at 10 frames/second so the motion is fluid; blink yellow/red
      # keyed to the countdown's seconds parity so the color change stays a
      # calm once-a-second beat rather than a 10 Hz strobe.
      local color=yellow
      ((remaining % 2)) && color=red
      glyph="#[fg=${color},bold]${frames[spin % 10]}#[default]"
      printf -v text ' #[fg=%s,bold]| %d:%02d left#[default]' \
        "$color" $((remaining / 60)) $((remaining % 60))
      spin=$((spin + 1))
      sleep_for=0.1
    fi

    local left=" ${glyph}${base}${text} "
    if [[ "$left" != "$last" ]]; then
      $TMUX_BIN -L "$sock" set-option -t "$session_name" status-left "$left"
      last="$left"
    fi
    sleep "$sleep_for"
  done

  rm -f "$state_file" "${state_file}.tmp" "${state_file%.json}.poke"
}

function start_tmux {
  export TERM=xterm-256color

  # Optional feature flags passed after "tmux" on the sbatch command line.
  local enable_mouse=0
  local disp_name=''
  local maint_spec=''
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --mouse)
      enable_mouse=1
      shift
      ;;
    --session-name=*)
      disp_name="${1#--session-name=}"
      shift
      ;;
    --maint=*)
      maint_spec="${1#--maint=}"
      shift
      ;;
    *) shift ;;
    esac
  done

  local session_name="sinteractive-${SLURM_JOB_ID}"
  local wait_channel="sinteractive-done-${SLURM_JOB_ID}"
  local sock="sinteractive-${SLURM_JOB_ID}"

  # Each job gets its own tmux server socket (-L) so that SLURM cgroup
  # cleanup for one job does not kill the tmux server shared by others.
  $TMUX_BIN -L "$sock" -u new-session -d -s "$session_name"

  # tmux >= 3.7 resizes existing panes when history-limit changes, so setting
  # it globally after new-session applies to the initial pane too; every split
  # inherits the global value.
  $TMUX_BIN -L "$sock" set-option -g history-limit 50000

  # OSC 52 clipboard integration (copy works over SSH)
  $TMUX_BIN -L "$sock" set-option -t "$session_name" set-clipboard on
  # vi-style copy mode regardless of $EDITOR (tmux defaults to emacs keys
  # unless EDITOR contains "vi"), so the keys in the help popup are always
  # right: Space starts a selection, Enter copies (to the local clipboard
  # via OSC 52 above). Keyboard selection avoids the jumpy mouse/scrollbar
  # path entirely.
  $TMUX_BIN -L "$sock" set-option -g mode-keys vi
  # OSC 8 hyperlinks (docs link in the help popup): tmux only re-emits them to
  # clients whose terminal declares the feature, and it can't detect support
  # from TERM alone, so assert it for all clients. Terminals without OSC 8
  # ignore the sequence; the link text still renders.
  $TMUX_BIN -L "$sock" set-option -sa terminal-features ',*:hyperlinks'
  # Let applications see terminal focus changes (autoread, cursor-shape, etc.).
  # escape-time is left at the tmux >= 3.5 default of 10ms (snappy ESC in vim).
  $TMUX_BIN -L "$sock" set-option -t "$session_name" focus-events on
  # Keep dead panes visible on non-zero exit for debugging (tmux >= 3.4).
  $TMUX_BIN -L "$sock" set-option -t "$session_name" remain-on-exit failed
  # pane-died: on Ctrl-C/SIGINT (exit 130) respawn the pane instead of leaving
  # "Pane is dead"; otherwise, if the dead pane was the last LIVE pane in the
  # session, end the session so the job exits. Without this, a login shell
  # exiting non-zero (e.g. a failed last command then Ctrl-D) would linger as a
  # dead pane, keeping session-closed from firing and stranding the allocation.
  # Dead panes in a multi-pane layout are still kept for inspection.
  $TMUX_BIN -L "$sock" set-hook -t "$session_name" pane-died \
    "run-shell \"if [ '#{pane_dead_status}' = 130 ]; then $TMUX_BIN -L $sock respawn-pane -k -t '#{pane_id}'; elif [ \\\$($TMUX_BIN -L $sock list-panes -s -t $session_name -F '##{pane_dead}' | grep -cx 0) -eq 0 ]; then $TMUX_BIN -L $sock kill-session -t $session_name; fi\""
  # Highlight windows with new activity
  $TMUX_BIN -L "$sock" set-option -t "$session_name" monitor-activity on
  # Auto-rename windows to current command
  $TMUX_BIN -L "$sock" set-option -t "$session_name" automatic-rename on
  # Opt-in mouse support (--mouse): wheel scrollback, click to select panes,
  # drag borders to resize. Off by default because it intercepts terminal
  # selection (hold Shift to select for an OS-level copy); with set-clipboard
  # on, tmux's own mouse selection copies out over SSH via OSC 52.
  if ((enable_mouse)); then
    $TMUX_BIN -L "$sock" set-option -t "$session_name" mouse on
    # tmux >= 3.6: show a per-pane scrollbar so wheel scrollback has a visible
    # position indicator. tmux >= 3.7: focus the pane under the cursor.
    $TMUX_BIN -L "$sock" set-option -t "$session_name" pane-scrollbars on
    $TMUX_BIN -L "$sock" set-option -t "$session_name" focus-follows-mouse on
  fi

  # Strip SLURM vars from tmux session so child processes (e.g. snakemake)
  # don't think they're running as a SLURM job step.
  # set-environment -u prevents future panes from inheriting the vars;
  # send-keys unsets them in the already-running initial shell.
  for var in $(env | grep ^SLURM_ | cut -d= -f1); do
    $TMUX_BIN -L "$sock" set-environment -t "$session_name" -u "$var"
  done

  # Expose the job identity to shells inside the session, so tools and agents
  # can introspect ("sinteractive --status" with no target reports on the
  # current session). set-environment covers panes created later; the
  # send-keys below covers the already-running initial shell.
  $TMUX_BIN -L "$sock" set-environment -t "$session_name" SINTERACTIVE_JOB_ID "${SLURM_JOB_ID}"
  local init_env="export SINTERACTIVE_JOB_ID=${SLURM_JOB_ID}"
  if [[ -n "$disp_name" ]]; then
    $TMUX_BIN -L "$sock" set-environment -t "$session_name" SINTERACTIVE_NAME "$disp_name"
    init_env+=" SINTERACTIVE_NAME=${disp_name}"
  fi
  $TMUX_BIN -L "$sock" send-keys -t "$session_name" \
    " unset \${!SLURM_@}; ${init_env}; clear" Enter

  # Status bar: no background color (terminal default), separated from the
  # pane by a thin border line. Left = a status glyph (a dot in the default
  # foreground color, so it adapts to light and dark themes; becomes a
  # time-remaining clock near the limit — see status_dot_loop, which keeps
  # this string updated) and the job ID + host in bold cyan (#2DBFB8, the
  # teal-cyan rustc/cargo use for ANSI cyan), with the label and separator
  # dimmed. Right = hint for the help popup; the full help (reattach command,
  # docs link, tmux keys) lives in the Ctrl+b h modal.
  # The trailing conditional appends "| <name>" when the session has a name.
  # tmux format lookup falls back to the session environment, so the segment
  # tracks SINTERACTIVE_NAME live (set at launch with --name, or later via
  # prefix+$). Must mirror the base string in status_dot_loop. The #, inside
  # the conditional escapes the style comma, which would otherwise terminate
  # the branch.
  local name_fmt='#{?SINTERACTIVE_NAME, #[dim]|#[default] #[fg=#2DBFB8#,bold]#{SINTERACTIVE_NAME}#[default],}'
  $TMUX_BIN -L "$sock" set-option -t "$session_name" status-style 'fg=default,bg=default'
  $TMUX_BIN -L "$sock" set-option -t "$session_name" status-left \
    " #[bold]●#[default] #[dim]session#[default] #[fg=#2DBFB8,bold]${SLURM_JOB_ID}#[default] #[dim]|#[default] #[fg=#2DBFB8,bold]#{host_short}#[default]${name_fmt} "
  $TMUX_BIN -L "$sock" set-option -t "$session_name" status-left-length 80
  # Hide the window list (0:bash*) from the center of the status bar
  $TMUX_BIN -L "$sock" set-option -t "$session_name" window-status-format ''
  $TMUX_BIN -L "$sock" set-option -t "$session_name" window-status-current-format ''
  $TMUX_BIN -L "$sock" set-option -t "$session_name" status-right \
    " Help: #[fg=yellow,bold]Ctrl+b h#[default] | Detach: #[fg=yellow,bold]Ctrl+b d#[default] "
  $TMUX_BIN -L "$sock" set-option -t "$session_name" status-right-length 40
  # Terminal window/tab title (OSC 2): mirror the status-left text so users
  # with several sessions can tell tabs apart at a glance.
  $TMUX_BIN -L "$sock" set-option -t "$session_name" set-titles on
  $TMUX_BIN -L "$sock" set-option -t "$session_name" set-titles-string \
    "session ${SLURM_JOB_ID} | #{host_short}#{?SINTERACTIVE_NAME, | #{SINTERACTIVE_NAME},}"
  # Separator line between the terminal and the status bar: show the pane's
  # bottom border as a heavy rule in palette yellow (empty format = no title
  # text). Palette yellow, not a hex value, so light themes that remap
  # yellow to a darker amber keep the rule visible on white backgrounds
  # (hardcoded #F0E442 was ~1.3:1 contrast on white — invisible). Global so
  # windows created later get it too.
  #
  # It stays empty for the life of the session. Everything the session has to
  # say goes below the status bar instead (see apply_notice_lines), where a
  # message gets a whole line rather than a gap cut into the rule.
  $TMUX_BIN -L "$sock" set-option -g pane-border-status bottom
  $TMUX_BIN -L "$sock" set-option -g pane-border-format ''
  $TMUX_BIN -L "$sock" set-option -g pane-border-lines heavy
  $TMUX_BIN -L "$sock" set-option -g pane-border-style 'fg=yellow'
  $TMUX_BIN -L "$sock" set-option -g pane-active-border-style 'fg=yellow'

  # Help popup: prefix + h opens a modal with job info and key help, closed by
  # any key. Bindings are per-server, and each job has its own socket, so this
  # can't leak into other tmux servers. BASH_SOURCE here is Slurm's spooled
  # copy of this script, which stays executable on this node for the job's
  # lifetime, so the popup can re-invoke it as "help-popup JOBID".
  $TMUX_BIN -L "$sock" bind-key h display-popup -E -w 76 -h 28 \
    -T ' sinteractive help ' \
    "'${BASH_SOURCE[0]}' help-popup ${SLURM_JOB_ID}"

  # Name/rename the session in place: prefix + $ prompts for a name and
  # hands it to the rename-session handler (scontrol Comment/Name update,
  # SINTERACTIVE_NAME env). This deliberately overrides tmux's stock $
  # (rename-session): renaming the tmux session itself would desync
  # status_dot_loop's has-session/set-option targets and the literal session
  # name baked into the pane-died hook above. The prompt is prefilled with
  # the current name (format lookup falls back to the session environment).
  # Quoting: tmux substitutes %%% for the reply, backslash-escaping
  # double-quote/backslash/dollar/semicolon/tilde; the single-quoted tmux
  # template passes those through to run-shell's /bin/sh -c, where the inner
  # double quotes are exactly right. A literal single quote in the reply
  # breaks tmux parsing with a status-line error before the handler runs —
  # cosmetic only, on the user's own per-job server, and no such input would
  # pass the handler's name validation anyway.
  $TMUX_BIN -L "$sock" bind-key '$' command-prompt -p ' session name:' \
    -I '#{SINTERACTIVE_NAME}' \
    "run-shell '\"${BASH_SOURCE[0]}\" rename-session ${SLURM_JOB_ID} \"%%%\"'"

  $TMUX_BIN -L "$sock" set-hook -t "$session_name" session-closed \
    "run-shell '$TMUX_BIN -L $sock wait-for -S $wait_channel'"

  # Keep the status-bar glyph in sync with the job's time remaining.
  status_dot_loop "$session_name" "$disp_name" "$maint_spec" &

  # Ignore USR1: nothing traps it anymore (the old warning banner did), and
  # the default disposition would kill this batch shell if the user submits
  # with their own --signal=B:USR1.
  trap ':' USR1

  # Slurm delivers SIGTERM on scancel and at timeout (SIGKILL follows after
  # KillWait); remove the state file on the way out so it can't go stale.
  trap 'rm -f "${HOME}/.cache/sinteractive/${SLURM_JOB_ID}.json" \
    "${HOME}/.cache/sinteractive/${SLURM_JOB_ID}.json.tmp" \
    "${HOME}/.cache/sinteractive/${SLURM_JOB_ID}.poke"; exit 0' TERM

  # Run wait-for in background; `wait` builtin (foreground) is interruptible
  # by signals, unlike external commands which block trap delivery in bash.
  $TMUX_BIN -L "$sock" wait-for "$wait_channel" &
  local wait_pid=$!
  while true; do
    wait $wait_pid
    # 0 or 1-128 = process exited; >128 = signal interrupted wait
    if (($? <= 128)); then
      break
    fi
  done

  # Belt-and-braces: status_dot_loop removes its state file when it sees the
  # session die, but Slurm's cgroup cleanup can kill it mid-sleep first.
  rm -f "${HOME}/.cache/sinteractive/${SLURM_JOB_ID}.json" \
    "${HOME}/.cache/sinteractive/${SLURM_JOB_ID}.json.tmp" \
    "${HOME}/.cache/sinteractive/${SLURM_JOB_ID}.poke"

  trap - USR1
}

function attach_tmux {
  local SESSION=$1
  local sock="$SESSION"

  if [[ "${DISPLAY:-}" != '' ]]; then
    $TMUX_BIN -L "$sock" setenv -t "$SESSION" DISPLAY "$DISPLAY"
  fi

  exec $TMUX_BIN -L "$sock" -u attach-session -t "$SESSION"
}

function cleanup {
  # Disarm first: the exit below re-enters this handler via the EXIT trap,
  # which would scancel and report the cancellation a second time.
  trap - SIGINT SIGTERM EXIT

  if [[ -n "${JOB_ID}" ]]; then
    scancel --quiet "${JOB_ID}"
    # Close the loop for a Ctrl-C during the pending wait: without this the
    # job vanishes silently and users wonder where it went.
    echo 1>&2 ''
    echo 1>&2 "${C_OK}✓${C_RST} ${C_DIM}Cancelled job${C_RST} ${C_ID}${JOB_ID}${C_RST}${C_DIM}.${C_RST}"
  fi

  exit
}

trap cleanup SIGINT SIGTERM EXIT

main "$@"
