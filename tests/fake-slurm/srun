#!/usr/bin/env bash
# Fake srun: runs the command locally. See README.md.
#
# Everything after `--` is the command. Without a `--`, srun's own options
# are skipped (-w -N -n -c -p -t -J -q -A --jobid --nodelist --export take a
# separate value; --overlap, --pty and other flags do not) and the first
# bare token starts the command.

# shellcheck source=tests/fake-slurm/lib.sh
source "$(dirname "$(readlink -f "$0")")/lib.sh"
log_call srun "$@"

while [[ $# -gt 0 ]]; do
  case "$1" in
  --)
    shift
    break
    ;;
  -w | -N | -n | -c | -p | -t | -J | -q | -A | --jobid | --nodelist | --export)
    shift 2
    ;;
  -*) shift ;;
  *) break ;;
  esac
done

[[ $# -gt 0 ]] || die "srun: error: no command given (fake-slurm)"
exec "$@"
